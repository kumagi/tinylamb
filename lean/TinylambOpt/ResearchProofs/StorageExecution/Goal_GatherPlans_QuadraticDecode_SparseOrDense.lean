import TinylambOpt.ResearchGoals.StorageExecution.GatherPlans

/-!
Late materialization can gather payloads at selected row positions while preserving the
selection's order and multiplicities.

Proved

- `QuadraticDecode.SparseOrDense` — `∀ (fixedFee : Nat), sparseOrDense (price
  fixedFee)`
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000
set_option linter.unusedSimpArgs false

namespace TinylambOpt.ResearchProofs.StorageExecution.Goal_GatherPlans_QuadraticDecode_SparseOrDense

open TinylambOpt.ResearchGoals.StorageExecution.GatherPlans
open TinylambOpt.ResearchGoals.StorageExecution.GatherPlans.QuadraticDecode

/-! `choose` sorts every covering plan by cost and takes the head, so its cost is
no larger than the cost of any particular covering.  Both the all-singleton
plan and the single bounding extent are generated by `covers`; hence the chosen
plan is no worse than either of the two reference strategies.  The argument is
independent of the price function, so it applies to the quadratic-decode model. -/

private theorem covers_nonempty (xs : List Nat) : ∃ ps, ps ∈ covers xs := by
  induction xs with
  | nil => exact ⟨[], by simp [covers]⟩
  | cons x xs ih =>
    obtain ⟨q, hq⟩ := ih
    cases q with
    | nil =>
      exact ⟨[(x, x)], by
        rw [covers]
        exact List.mem_flatMap.mpr ⟨[], hq, by simp⟩⟩
    | cons e rest =>
      exact ⟨(x, x) :: e :: rest, by
        rw [covers]
        exact List.mem_flatMap.mpr ⟨e :: rest, hq, by simp⟩⟩

private theorem covers_ne_nil (xs : List Nat) : covers xs ≠ [] := by
  obtain ⟨ps, hps⟩ := covers_nonempty xs
  intro h
  simp [h] at hps

private theorem pairwise_head?_le {α : Type} {le : α → α → Bool}
    (hrefl : ∀ x, le x x = true)
    {l : List α} {a b : α} (hpw : l.Pairwise (fun x y => le x y = true))
    (hhead : l.head? = some a) (hmem : b ∈ l) : le a b = true := by
  cases l with
  | nil => simp at hmem
  | cons x xs =>
    simp at hhead
    subst hhead
    rw [List.pairwise_cons] at hpw
    rcases List.mem_cons.mp hmem with rfl | hmem
    · exact hrefl _
    · exact hpw.1 b hmem

private theorem choose_le (f : Price) (xs : List Nat) (ps : List Extent)
    (hmem : ps ∈ covers (points xs)) :
    cost f (choose f xs) ≤ cost f ps := by
  unfold choose
  let le := fun a b => decide (cost f a ≤ cost f b)
  have hpair : List.Pairwise (fun a b => le a b = true)
      ((covers (points xs)).mergeSort le) := by
    apply List.pairwise_mergeSort
    · intro a b c hab hbc
      simp only [le, decide_eq_true_eq] at hab hbc ⊢
      exact Nat.le_trans hab hbc
    · intro a b
      simp only [le, Bool.or_eq_true, decide_eq_true_eq]
      exact Nat.le_total (cost f a) (cost f b)
  have hmem' : ps ∈ (covers (points xs)).mergeSort le := List.mem_mergeSort.mpr hmem
  cases h : (covers (points xs)).mergeSort le with
  | nil => simp [h] at hmem'
  | cons hd tl =>
    simp only [h, List.head?_cons, Option.getD_some]
    have hle := pairwise_head?_le (fun x => by simp [le]) hpair
      (show ((covers (points xs)).mergeSort le).head? = some hd by simp [h]) hmem'
    simpa [le] using hle

private theorem singleton_mem_covers : ∀ xs : List Nat,
    xs.map (fun k => (k, k)) ∈ covers xs := by
  intro xs
  induction xs with
  | nil => simp [covers]
  | cons x xs ih =>
    rw [covers]
    refine List.mem_flatMap.mpr ⟨xs.map (fun k => (k, k)), ih, ?_⟩
    cases xs <;> simp

private theorem getLast_cons_cons (x y : Nat) (ys : List Nat) :
    (x :: y :: ys).getLast? = (y :: ys).getLast? := by
  simp

private theorem bounding_mem_covers : ∀ xs : List Nat, xs ≠ [] →
    [(xs.head?.getD 0, xs.getLast?.getD 0)] ∈ covers xs := by
  intro xs
  induction xs with
  | nil => intro h; contradiction
  | cons x xs ih =>
    cases xs with
    | nil => simp [covers]
    | cons y ys =>
      intro hne
      have htail : [((y :: ys).head?.getD 0, (y :: ys).getLast?.getD 0)] ∈ covers (y :: ys) :=
        ih (by simp)
      rw [covers]
      refine List.mem_flatMap.mpr
        ⟨[((y :: ys).head?.getD 0, (y :: ys).getLast?.getD 0)], htail, ?_⟩
      simp [getLast_cons_cons]

theorem sound_SparseOrDense : QuadraticDecode.SparseOrDense.Goal := by
  intro fee xs hxs
  change cost (price fee) (choose (price fee) xs) ≤
    min (((points xs).map (fun k => price fee k k)).sum)
      (price fee ((points xs).head?.getD 0) ((points xs).getLast?.getD 0))
  have hksne : points xs ≠ [] := by
    intro hnil
    have hxmem : xs.head?.getD 0 ∈ xs := by
      cases xs with
      | nil => contradiction
      | cons x xs' => simp
    have hxmem' : xs.head?.getD 0 ∈ points xs := by
      simpa [points] using hxmem
    rw [hnil] at hxmem'
    simp at hxmem'
  have hle1 : cost (price fee) (choose (price fee) xs) ≤
      ((points xs).map (fun k => price fee k k)).sum := by
    have hmem : ((points xs).map (fun k => (k, k))) ∈ covers (points xs) :=
      singleton_mem_covers (points xs)
    have hc := choose_le (price fee) xs ((points xs).map (fun k => (k, k))) hmem
    simpa [cost, Function.comp_def] using hc
  have hle2 : cost (price fee) (choose (price fee) xs) ≤
      price fee ((points xs).head?.getD 0) ((points xs).getLast?.getD 0) := by
    have hmem : [((points xs).head?.getD 0, (points xs).getLast?.getD 0)] ∈ covers (points xs) :=
      bounding_mem_covers (points xs) hksne
    have hc := choose_le (price fee) xs
      [((points xs).head?.getD 0, (points xs).getLast?.getD 0)] hmem
    simpa [cost] using hc
  by_cases hmin : ((points xs).map (fun k => price fee k k)).sum ≤
      price fee ((points xs).head?.getD 0) ((points xs).getLast?.getD 0)
  · rw [Nat.min_eq_left hmin]
    exact hle1
  · have hle' : price fee ((points xs).head?.getD 0) ((points xs).getLast?.getD 0) ≤
        ((points xs).map (fun k => price fee k k)).sum := by omega
    rw [Nat.min_eq_right hle']
    exact hle2

end TinylambOpt.ResearchProofs.StorageExecution.Goal_GatherPlans_QuadraticDecode_SparseOrDense
