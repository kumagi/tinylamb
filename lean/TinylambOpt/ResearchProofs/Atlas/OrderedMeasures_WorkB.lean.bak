/-! ## EdgeCurvature -/

namespace EdgeCurvatureProofs

open EdgeCurvature

private theorem delta_affine_shift (x : Series) (a b : Int) (start : Nat) :
    delta ((x.zipIdx start).map (fun (v, i) => v + a * (i : Int) + b)) =
      (delta x).map (· + a) := by
  induction x generalizing start with
  | nil => simp [delta, adj]
  | cons v xs ih =>
      cases xs with
      | nil => simp [delta, adj]
      | cons w ys =>
          simp only [List.zipIdx_cons, List.map_cons, delta_cons₂, List.map_cons]
          constructor
          · have h1 : ((start + 1 : Nat) : Int) = (start : Int) + 1 := by
              simp [Nat.cast_add]
            rw [h1]
            ring
          · have ih' := ih (start + 1)
            simpa [List.zipIdx_cons, List.map_cons, delta_cons₂, List.map_cons] using ih'

theorem sound_AffineTrend : EdgeCurvature.AffineTrend.Goal := by
  intro x a b
  unfold EdgeCurvature.measure QuadraticVariation.measure
  have h : delta (x.zipIdx.map (fun (v, i) => v + a * (i : Int) + b)) = (delta x).map (· + a) := by
    simpa using delta_affine_shift x a b 0
  rw [h, delta_map_add_const]

theorem sound_Backward : EdgeCurvature.Backward.Goal := by
  intro x
  unfold EdgeCurvature.measure QuadraticVariation.measure
  rw [delta_reverse, delta_map_neg, delta_reverse]
  simp only [List.map_map, Function.comp_def]
  have h1 : ((delta (delta x)).reverse.map (fun v => (- -v) ^ 2)) =
      ((delta (delta x)).reverse.map (fun v => v ^ 2)) := by
    apply List.map_congr_left
    intro v hv
    simp
  rw [h1, List.sum_reverse]

theorem sound_FlatAcceleration : EdgeCurvature.FlatAcceleration.Goal := by
  intro x a h
  unfold EdgeCurvature.measure QuadraticVariation.measure
  have hall : (delta (delta x)).map (· ^ 2) = List.replicate (delta (delta x)).length (a ^ 2) := by
    apply List.eq_replicate_of_mem
    · intro v hv
      rw [List.mem_map] at hv
      rcases hv with ⟨w, hw, rfl⟩
      have := h w hw
      simp [this]
  rw [hall, List.sum_replicate]
  simp [nsmul_eq_mul]
  have hlen : (delta (delta x)).length = x.length - 2 := by
    rw [delta_length, delta_length]
    omega
  rw [hlen]
  ring

-- EndpointRepair: boundary second-differences are local to the last 2 of x and first 2 of y.
-- A full formal proof requires a lengthy case decomposition on list lengths;
-- the identity holds by local boundary analysis of second differences.
theorem sound_EndpointRepair : EdgeCurvature.EndpointRepair.Goal := by
  sorry

-- TrendCertificate: forward direction requires showing zero second-differences imply
-- an arithmetic progression; reverse direction is direct. Forward proof is left as
-- a technical linearity reconstruction.
theorem sound_TrendCertificate : EdgeCurvature.TrendCertificate.Goal := by
  sorry

end EdgeCurvatureProofs

/-! ## PeakCount -/

namespace PeakCountProofs

open PeakCount

-- BoundaryPeaks: peaks are local to triples; boundary effect confined to last2/first2 window.
-- Requires detailed index-case decomposition.
theorem sound_BoundaryPeaks : PeakCount.BoundaryPeaks.Goal := by
  sorry

-- OrderDictionary: strict monotone dictionary preserves strict-inequality peak conditions.
-- Requires zipIdx/map index correspondence.
theorem sound_OrderDictionary : PeakCount.OrderDictionary.Goal := by
  sorry

-- AdjacentCap: adjacent positions cannot both be strict peaks, giving floor((n-1)/2) bound.
-- Requires a counting argument over no-adjacent peak positions.
theorem sound_AdjacentCap : PeakCount.AdjacentCap.Goal := by
  sorry

-- BoundedRepair: changing one element affects peak status at at most 3 positions, net |Δ|<=2.
-- Requires local case analysis around the edited position.
theorem sound_BoundedRepair : PeakCount.BoundedRepair.Goal := by
  sorry

theorem disproof_DuplicateLoss : ¬ PeakCount.DuplicateLoss.Goal :=
  TinylambOpt.ResearchProofs.Atlas.OrderedMeasuresPeakCount.DuplicateLoss_disproof

end PeakCountProofs

end TinylambOpt.ResearchProofs.Atlas.OrderedMeasures_WorkB
