import TinylambOpt.ResearchGoals.Atlas.OrderedMeasures
import TinylambOpt.ResearchProofs.Atlas_OrderedMeasures_ZeroFrames_Remaining
import TinylambOpt.ResearchProofs.Atlas.OrderedMeasuresPeakCount

set_option maxHeartbeats 0
set_option maxRecDepth 10000

namespace TinylambOpt.ResearchProofs.Atlas.OrderedMeasures_WorkB

open TinylambOpt.ResearchGoals.Atlas.OrderedMeasures
open TinylambOpt.ResearchGoals.PairAggregates (choose2)

/-! ## Helpers -/

private theorem adj_cons₂ (a b : Int) (xs : Series) :
    adj (a :: b :: xs) = (a, b) :: adj (b :: xs) := by
  simp [adj]

private theorem adj_map (f : Int → Int) (x : Series) :
    adj (x.map f) = (adj x).map (fun p => (f p.1, f p.2)) := by
  induction x with
  | nil => simp [adj]
  | cons a xs ih =>
      cases xs with
      | nil => simp [adj]
      | cons b ys => simp [adj, ih]

private theorem delta_cons₂ (a b : Int) (xs : Series) :
    delta (a :: b :: xs) = (b - a) :: delta (b :: xs) := by
  simp [delta, adj]

private theorem delta_map (f : Int → Int) (x : Series) :
    delta (x.map f) = (adj x).map (fun p => f p.2 - f p.1) := by
  simp [delta, adj_map, List.map_map, Function.comp_def]

private theorem delta_map_add_const (x : Series) (c : Int) :
    delta (x.map (· + c)) = delta x := by
  rw [delta_map, delta]
  congr 1
  apply List.map_congr_left
  intro p hp
  simp

private theorem delta_length (x : Series) : (delta x).length = x.length - 1 := by
  simp [delta, adj, List.length_zip, List.length_drop]
  omega

private theorem adj_append_singleton (x : Series) (a : Int) :
    adj (x ++ [a]) = adj x ++ (match x.getLast? with | some b => [(b, a)] | none => []) := by
  induction x with
  | nil => simp [adj]
  | cons b xs ih =>
      cases xs with
      | nil => simp [adj]
      | cons c ys => simp [adj, ih]

private theorem adj_reverse (x : Series) :
    adj (x.reverse) = (adj x).reverse.map (fun p => (p.2, p.1)) := by
  induction x with
  | nil => simp [adj]
  | cons a xs ih =>
      cases xs with
      | nil => simp [adj]
      | cons b ys =>
          simp only [List.reverse_cons]
          rw [adj_append_singleton, ih, adj_cons₂]
          simp

private theorem delta_reverse (x : Series) :
    delta (x.reverse) = (delta x).reverse.map (fun v => -v) := by
  rw [delta, adj_reverse, List.map_map, List.map_map]
  congr 1
  apply List.map_congr_left
  intro p hp
  simp
  ring

private theorem delta_map_neg (x : Series) :
    delta (x.map (fun v => -v)) = (delta x).map (fun v => -v) := by
  rw [delta_map, delta]
  simp only [List.map_map, Function.comp_def]
  congr 1
  apply List.map_congr_left
  intro p hp
  ring

