/-! ## Remaining goals -/

namespace MovieCredits
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.MovieCredits
private theorem mc_reference_eq (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b = triT n db 0 1 2 := by
  have hshape : reference pattern n (bin db) b = rsum n (fun v2 => rsum n (fun v3 =>
      rsum n (fun v1 => bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))) := by
    simp [reference, pattern, integrate, value, put, rsum, bin]
  rw [hshape]
  rw [rsum_comm n n (fun v2 v3 => rsum n (fun v1 =>
    bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))]
  have h2 : (fun v3 => rsum n (fun v2 => rsum n (fun v1 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))) =
      (fun v3 => rsum n (fun v1 => rsum n (fun v2 =>
        bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))) := by
    funext v3
    exact rsum_comm n n (fun v2 v1 => bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1))
  rw [h2]
  have hc1 : rsum n (fun v3 => rsum n (fun v1 => rsum n (fun v2 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1))))
      = rsum n (fun v1 => rsum n (fun v3 => rsum n (fun v2 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))) :=
    rsum_comm n n (fun v3 v1 => rsum n (fun v2 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))
  have hc2 : rsum n (fun v1 => rsum n (fun v3 => rsum n (fun v2 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1))))
      = rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))) :=
    congrArg (rsum n) (funext fun v1 => rsum_comm n n (fun v3 v2 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))
  have hc3 : (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 v1 v2 * (bin db 1 v2 v3 * bin db 2 v3 v1)))) =
      (fun x => rsum n (fun y => rsum n (fun z =>
        bin db 2 z x * (bin db 0 x y * bin db 1 y z)))) := by
    funext v1
    refine congrArg (rsum n) (funext fun v2 => congrArg (rsum n) (funext fun v3 => ?_))
    ac_rfl
  dsimp only [triT]
  exact hc1.trans (hc2.trans (congrArg (rsum n) hc3))

theorem sound_FractionalCap : FractionalCap.Goal := by
  intro n db b weights den hcover
  obtain ⟨hpos, hlen, hv⟩ := hcover
  obtain ⟨w0, w1, w2, rfl⟩ := list3_of_length3 weights hlen
  have hzip : pattern.atoms.zip [w0, w1, w2] =
      [(⟨0, 1, 2⟩, w0), (⟨1, 2, 3⟩, w1), (⟨2, 3, 1⟩, w2)] := by
    simp [pattern, List.zip]
  have hv1 := hv 1 (by simp [pattern])
  have hv2 := hv 2 (by simp [pattern])
  have hv3 := hv 3 (by simp [pattern])
  rw [hzip] at hv1 hv2 hv3
  simp at hv1 hv2 hv3
  rw [show (fun r x y => if db r x y == 0 then 0 else 1) = bin db from rfl]
  have hcount : (reference pattern n (bin db) b).toNat = (satBindings pattern n db b).length := by
    rw [reference_bin_count pattern n db b]
    exact Int.ofNat_inj.mp (Int.toNat_of_nonneg (int_coe_nonneg _))
  rw [hcount]
  have hrhs : ((pattern.atoms.zip [w0, w1, w2]).map (fun (a, w) =>
      support n db a pattern b ^ w)).prod =
      support n db ⟨0, 1, 2⟩ pattern b ^ w0 *
        (support n db ⟨1, 2, 3⟩ pattern b ^ w1 * support n db ⟨2, 3, 1⟩ pattern b ^ w2) := by
    rw [hzip]
    simp
  rw [hrhs]
  have hL : ((satBindings pattern n db b).length : Int) = triT n db 0 1 2 :=
    ((mc_reference_eq n db b).symm.trans (reference_bin_count pattern n db b)).symm
  have hS0 : (support n db ⟨0, 1, 2⟩ pattern b : Int) = triE n db 0 :=
    support_eq_triE pattern n db b 0 1 2 (by simp [pattern]) (by simp [pattern])
  have hS1 : (support n db ⟨1, 2, 3⟩ pattern b : Int) = triE n db 1 :=
    support_eq_triE pattern n db b 1 2 3 (by simp [pattern]) (by simp [pattern])
  have hS2 : (support n db ⟨2, 3, 1⟩ pattern b : Int) = triE n db 2 :=
    support_eq_triE pattern n db b 2 3 1 (by simp [pattern]) (by simp [pattern])
  have h12 : (satBindings pattern n db b).length ≤
      support n db ⟨0, 1, 2⟩ pattern b * support n db ⟨1, 2, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS0, hS1]
    exact triT_le_triE_mul n db 0 1 2
  have h23 : (satBindings pattern n db b).length ≤
      support n db ⟨1, 2, 3⟩ pattern b * support n db ⟨2, 3, 1⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS1, hS2]
    rw [triT_cycle n db 0 1 2]
    exact triT_le_triE_mul n db 1 2 0
  have h31 : (satBindings pattern n db b).length ≤
      support n db ⟨2, 3, 1⟩ pattern b * support n db ⟨0, 1, 2⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS2, hS0]
    rw [triT_cycle n db 0 1 2, triT_cycle n db 1 2 0]
    exact triT_le_triE_mul n db 2 0 1
  have hcs : (satBindings pattern n db b).length ^ 2 ≤
      support n db ⟨0, 1, 2⟩ pattern b * support n db ⟨1, 2, 3⟩ pattern b *
        support n db ⟨2, 3, 1⟩ pattern b := by
    apply Int.ofNat_le.mp
    simp only [Int.natCast_pow, Int.natCast_mul]
    rw [hL, hS0, hS1, hS2]
    exact triangle_sq n db 0 1 2
  refine fc_mc _ _ _ _ h12 h23 h31 hcs _ w0 w1 w2 hpos ?_ ?_ ?_
  · omega
  · omega
  · omega
end MovieCredits

namespace KeywordCompany
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.KeywordCompany
private def kcA (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun y => bin db 0 (b 0) y)

private def kcB (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun y => bin db 1 (b 0) y)

private theorem kc_hshape (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b = rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))))) := by
  simp [reference, pattern, integrate, value, put, rsum, bin]

-- R ≤ kcB * triE 2
private theorem kc_R_le_BC (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ kcB n db b * triE n db 2 := by
  rw [kc_hshape]
  -- drop the a-factor (≤ 1), the d-factor (≤ 1); collapse v3 sum, then v2, then v1
  refine Int.le_trans (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))))
    (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))))
    (fun v1 _ => rsum_le n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))))
      (fun v2 => rsum n (fun v3 =>
        bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))
      (fun v2 _ => rsum_le n (fun v3 =>
          bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))
        (fun v3 => bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
        (fun v3 _ => ?_)))) ?_
  · have hbc0 : 0 ≤ (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3) : Int) :=
      Int.mul_nonneg (bin_nonneg db 1 (b 0) v2)
        (Int.mul_nonneg (bin_nonneg db 2 v1 v3) (bin_nonneg db 3 v2 v3))
    calc bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
        ≤ 1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)) :=
          Int.mul_le_mul (bin_le_one db 0 (b 0) v1) (Int.le_refl _) hbc0 (by omega)
      _ = bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3) := by simp
  · -- rsum v1 rsum v2 rsum v3 b·(c·d) ≤ rsum v1 o2 v1 · kcB = triE2 · kcB → kcB·triE2
    have hs3 (v1 v2 : Nat) : rsum n (fun v3 =>
        bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
        ≤ bin db 1 (b 0) v2 * rsum n (fun v3 => bin db 2 v1 v3) := by
      refine Int.le_trans
        (rsum_le n (fun v3 => bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
          (fun v3 => bin db 1 (b 0) v2 * bin db 2 v1 v3) fun v3 _ => ?_) ?_
      · have hcb : 0 ≤ (bin db 2 v1 v3 : Int) := bin_nonneg db 2 v1 v3
        have hb0 : 0 ≤ (bin db 1 (b 0) v2 : Int) := bin_nonneg db 1 (b 0) v2
        calc bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)
            = (bin db 1 (b 0) v2 * bin db 2 v1 v3) * bin db 3 v2 v3 := by rw [Int.mul_assoc]
          _ ≤ (bin db 1 (b 0) v2 * bin db 2 v1 v3) * 1 :=
              Int.mul_le_mul (Int.le_refl _) (bin_le_one db 3 v2 v3)
                (bin_nonneg db 3 v2 v3) (Int.mul_nonneg hb0 hcb)
          _ = bin db 1 (b 0) v2 * bin db 2 v1 v3 := by simp
      · exact Int.le_of_eq (rsum_const_mul n (bin db 1 (b 0) v2) (fun v3 => bin db 2 v1 v3))
    have hs2 (v1 : Nat) : rsum n (fun v2 =>
        rsum n (fun v3 => bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))
        ≤ rsum n (fun v2 => bin db 1 (b 0) v2 * rsum n (fun v3 => bin db 2 v1 v3)) :=
      rsum_le n _ _ fun v2 _ => hs3 v1 v2
    calc rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
          bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))) )
        ≤ rsum n (fun v1 => rsum n (fun v2 =>
            bin db 1 (b 0) v2 * rsum n (fun v3 => bin db 2 v1 v3))) :=
          rsum_le n _ _ fun v1 _ => hs2 v1
      _ = rsum n (fun v1 => rsum n (fun v3 => bin db 2 v1 v3) * kcB n db b) := by
          refine congrArg (rsum n) (funext fun v1 => ?_)
          rw [rsum_mul_const n (fun v2 => bin db 1 (b 0) v2) (rsum n fun v3 => bin db 2 v1 v3)]
          rw [show rsum n (fun v2 => bin db 1 (b 0) v2) = kcB n db b from rfl, Int.mul_comm]
      _ = (rsum n (fun v1 => rsum n (fun v3 => bin db 2 v1 v3))) * kcB n db b :=
          rsum_mul_const n (fun v1 => rsum n (fun v3 => bin db 2 v1 v3)) (kcB n db b)
      _ = triE n db 2 * kcB n db b := rfl
      _ = kcB n db b * triE n db 2 := by rw [Int.mul_comm]

-- R ≤ kcA * triE 3
private theorem kc_R_le_AD (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ kcA n db b * triE n db 3 := by
  rw [kc_hshape]
  have hcd (v1 v2 v3 : Nat) :
      bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3) ≤ bin db 3 v2 v3 := by
    have h1 : 0 ≤ (bin db 2 v1 v3 * bin db 3 v2 v3 : Int) :=
      Int.mul_nonneg (bin_nonneg db 2 v1 v3) (bin_nonneg db 3 v2 v3)
    calc bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)
        ≤ 1 * (bin db 2 v1 v3 * bin db 3 v2 v3) :=
          Int.mul_le_mul (bin_le_one db 1 (b 0) v2) (Int.le_refl _) h1 (by omega)
      _ = bin db 2 v1 v3 * bin db 3 v2 v3 := by simp
      _ ≤ 1 * bin db 3 v2 v3 :=
          Int.mul_le_mul (bin_le_one db 2 v1 v3) (Int.le_refl _) (bin_nonneg db 3 v2 v3) (by omega)
      _ = bin db 3 v2 v3 := by simp
  have hbr (v1 : Nat) : rsum n (fun v2 => rsum n (fun v3 =>
      bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))
      ≤ triE n db 3 := by
    refine Int.le_trans (rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ => hcd v1 v2 v3) ?_
    exact Int.le_of_eq rfl
  refine Int.le_trans (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))))
    (fun v1 => bin db 0 (b 0) v1 * triE n db 3) fun v1 _ => ?_) ?_
  · have h1 : (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))))
        = (fun v2 => bin db 0 (b 0) v1 * rsum n (fun v3 =>
          bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))) := by
      funext v2
      exact rsum_const_mul n (bin db 0 (b 0) v1)
        (fun v3 => bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
    rw [h1]
    have hS0 : 0 ≤ rsum n (fun v2 => rsum n (fun v3 =>
        bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))) :=
      rsum_nonneg n (fun v2 => rsum n (fun v3 => bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))
        fun v2 _ => rsum_nonneg n (fun v3 => bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
          fun v3 _ => Int.mul_nonneg (bin_nonneg db 1 (b 0) v2)
            (Int.mul_nonneg (bin_nonneg db 2 v1 v3) (bin_nonneg db 3 v2 v3))
    refine Int.le_trans (Int.le_of_eq
        (rsum_const_mul n (bin db 0 (b 0) v1) (fun v2 => rsum n (fun v3 =>
          bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))))) ?_
    exact Int.mul_le_mul (Int.le_refl _) (hbr v1) hS0 (bin_nonneg db 0 (b 0) v1)
  · rw [rsum_mul_const]
    exact Int.le_refl _

-- R ≤ triE 2 * triE 3
private theorem kc_R_le_CD (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ triE n db 2 * triE n db 3 := by
  rw [kc_hshape]
  have hcd (v1 v2 v3 : Nat) :
      bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
      ≤ bin db 2 v1 v3 * bin db 3 v2 v3 := by
    have h1 : 0 ≤ (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3) : Int) :=
      Int.mul_nonneg (bin_nonneg db 1 (b 0) v2)
        (Int.mul_nonneg (bin_nonneg db 2 v1 v3) (bin_nonneg db 3 v2 v3))
    have h2 : 0 ≤ (bin db 2 v1 v3 * bin db 3 v2 v3 : Int) :=
      Int.mul_nonneg (bin_nonneg db 2 v1 v3) (bin_nonneg db 3 v2 v3)
    calc bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3))
        ≤ 1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)) :=
          Int.mul_le_mul (bin_le_one db 0 (b 0) v1) (Int.le_refl _) h1 (by omega)
      _ = bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3) := by simp
      _ ≤ 1 * (bin db 2 v1 v3 * bin db 3 v2 v3) :=
          Int.mul_le_mul (bin_le_one db 1 (b 0) v2) (Int.le_refl _) h2 (by omega)
      _ = bin db 2 v1 v3 * bin db 3 v2 v3 := by simp
  refine Int.le_trans (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 1 (b 0) v2 * (bin db 2 v1 v3 * bin db 3 v2 v3)))))
    (fun v1 => rsum n (fun v2 => rsum n (fun v3 => bin db 2 v1 v3 * bin db 3 v2 v3)))
    fun v1 _ => rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ => hcd v1 v2 v3) ?_
  have hcol (v3 : Nat) (hv3 : v3 < n) : rsum n (fun v2 => bin db 3 v2 v3) ≤ triE n db 3 := by
    refine Int.le_trans (rsum_le n (fun v2 => bin db 3 v2 v3)
      (fun v2 => rsum n (fun u => bin db 3 v2 u))
      fun v2 _ => rsum_ge_single n v3 (fun u => bin db 3 v2 u) hv3
        fun u _ => bin_nonneg db 3 v2 u) ?_
    exact Int.le_of_eq rfl
  have hswap : (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 2 v1 v3 * bin db 3 v2 v3)))
      = (fun v1 => rsum n (fun v3 => bin db 2 v1 v3 * rsum n (fun v2 => bin db 3 v2 v3))) := by
    funext v1
    refine (rsum_comm n n (fun v2 v3 => bin db 2 v1 v3 * bin db 3 v2 v3)).trans <|
      congrArg (rsum n) (funext fun v3 =>
        rsum_const_mul n (bin db 2 v1 v3) (fun v2 => bin db 3 v2 v3))
  calc rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 2 v1 v3 * bin db 3 v2 v3)))
      = rsum n (fun v1 => rsum n (fun v3 =>
          bin db 2 v1 v3 * rsum n (fun v2 => bin db 3 v2 v3))) := congrArg (rsum n) hswap
    _ ≤ rsum n (fun v1 => rsum n (fun v3 => bin db 2 v1 v3 * triE n db 3)) :=
        rsum_le n _ _ fun v1 _ => rsum_le n _ _ fun v3 hv3 =>
          Int.mul_le_mul (Int.le_refl _) (hcol v3 hv3)
            (rsum_nonneg n (fun v2 => bin db 3 v2 v3) fun v2 _ => bin_nonneg db 3 v2 v3)
            (bin_nonneg db 2 v1 v3)
    _ = rsum n (fun v1 => rsum n (fun v3 => bin db 2 v1 v3) * triE n db 3) := by
        refine congrArg (rsum n) (funext fun v1 => ?_)
        exact rsum_mul_const n (fun v3 => bin db 2 v1 v3) (triE n db 3)
    _ = triE n db 2 * triE n db 3 := by rw [rsum_mul_const]; try rfl

private theorem fc_kc (T A B C D : Nat) (hBC : T ≤ B * C) (hAD : T ≤ A * D) (hCD : T ≤ C * D) :
    ∀ den w0 w1 w2 w3 : Nat, 0 < den → den ≤ w0 + w2 → den ≤ w1 + w3 → den ≤ w2 + w3 →
      T ^ den ≤ A ^ w0 * B ^ w1 * C ^ w2 * D ^ w3 := by
  intro den
  induction den using Nat.strongRecOn with
  | ind den ih =>
      intro w0 w1 w2 w3 hden h1 h2 h3
      rcases Nat.eq_zero_or_pos T with hT0 | hTp
      · rw [hT0, Nat.zero_pow (by omega)]
        exact Nat.zero_le _
      · have hA1 : 1 ≤ A := by
          rcases Nat.eq_zero_or_pos A with hz | hz
          · rw [hz, Nat.zero_mul] at hAD; omega
          · omega
        have hB1 : 1 ≤ B := by
          rcases Nat.eq_zero_or_pos B with hz | hz
          · rw [hz, Nat.zero_mul] at hBC; omega
          · omega
        have hC1 : 1 ≤ C := by
          rcases Nat.eq_zero_or_pos C with hz | hz
          · rw [hz, Nat.mul_zero] at hBC; omega
          · omega
        have hD1 : 1 ≤ D := by
          rcases Nat.eq_zero_or_pos D with hz | hz
          · rw [hz, Nat.mul_zero] at hAD; omega
          · omega
        have hcase :
            (w1 > 0 ∧ w2 > 0) ∨ (w0 > 0 ∧ w3 > 0) ∨ (w2 > 0 ∧ w3 > 0 ∧ w2 + w3 > den) := by omega
        rcases hcase with ⟨hw1, hw2⟩ | ⟨hw0, hw3⟩ | ⟨hw2, hw3, hsl⟩
        · -- BC move
          have hih : T ^ (den - 1) ≤ A ^ w0 * B ^ (w1 - 1) * C ^ (w2 - 1) * D ^ w3 := by
            rcases Nat.eq_zero_or_pos (den - 1) with hz | hz
            · rw [hz, Nat.pow_zero]
              have ha : 1 ≤ A ^ w0 := Nat.one_le_pow _ _ hA1
              have hb : 1 ≤ B ^ (w1 - 1) := Nat.one_le_pow _ _ hB1
              have hc : 1 ≤ C ^ (w2 - 1) := Nat.one_le_pow _ _ hC1
              have hd : 1 ≤ D ^ w3 := Nat.one_le_pow _ _ hD1
              have h0 : (1 : Nat) * 1 ≤ A ^ w0 * B ^ (w1 - 1) := Nat.mul_le_mul ha hb
              have h20 : (1 : Nat) * 1 ≤ C ^ (w2 - 1) * D ^ w3 := Nat.mul_le_mul hc hd
              have := Nat.mul_le_mul h0 h20
              simpa [Nat.mul_assoc] using this
            · exact ih (den - 1) (by omega) w0 (w1 - 1) (w2 - 1) w3 (by omega) (by omega)
                (by omega) (by omega)
          rw [show den = (den - 1) + 1 by omega, Nat.pow_add, Nat.pow_one]
          refine Nat.le_trans (Nat.mul_le_mul hih hBC) (Nat.le_of_eq ?_)
          rw [pow_pred_mul B w1 (by omega), pow_pred_mul C w2 (by omega)]
          ac_rfl
        · -- AD move
          have hih : T ^ (den - 1) ≤ A ^ (w0 - 1) * B ^ w1 * C ^ w2 * D ^ (w3 - 1) := by
            rcases Nat.eq_zero_or_pos (den - 1) with hz | hz
            · rw [hz, Nat.pow_zero]
              have ha : 1 ≤ A ^ (w0 - 1) := Nat.one_le_pow _ _ hA1
              have hb : 1 ≤ B ^ w1 := Nat.one_le_pow _ _ hB1
              have hc : 1 ≤ C ^ w2 := Nat.one_le_pow _ _ hC1
              have hd : 1 ≤ D ^ (w3 - 1) := Nat.one_le_pow _ _ hD1
              have h0 : (1 : Nat) * 1 ≤ A ^ (w0 - 1) * B ^ w1 := Nat.mul_le_mul ha hb
              have h20 : (1 : Nat) * 1 ≤ C ^ w2 * D ^ (w3 - 1) := Nat.mul_le_mul hc hd
              have := Nat.mul_le_mul h0 h20
              simpa [Nat.mul_assoc] using this
            · exact ih (den - 1) (by omega) (w0 - 1) w1 w2 (w3 - 1) (by omega) (by omega)
                (by omega) (by omega)
          rw [show den = (den - 1) + 1 by omega, Nat.pow_add, Nat.pow_one]
          refine Nat.le_trans (Nat.mul_le_mul hih hAD) (Nat.le_of_eq ?_)
          rw [pow_pred_mul A w0 (by omega), pow_pred_mul D w3 (by omega)]
          ac_rfl
        · -- CD move
          have hih : T ^ (den - 1) ≤ A ^ w0 * B ^ w1 * C ^ (w2 - 1) * D ^ (w3 - 1) := by
            rcases Nat.eq_zero_or_pos (den - 1) with hz | hz
            · rw [hz, Nat.pow_zero]
              have ha : 1 ≤ A ^ w0 := Nat.one_le_pow _ _ hA1
              have hb : 1 ≤ B ^ w1 := Nat.one_le_pow _ _ hB1
              have hc : 1 ≤ C ^ (w2 - 1) := Nat.one_le_pow _ _ hC1
              have hd : 1 ≤ D ^ (w3 - 1) := Nat.one_le_pow _ _ hD1
              have h0 : (1 : Nat) * 1 ≤ A ^ w0 * B ^ w1 := Nat.mul_le_mul ha hb
              have h20 : (1 : Nat) * 1 ≤ C ^ (w2 - 1) * D ^ (w3 - 1) := Nat.mul_le_mul hc hd
              have := Nat.mul_le_mul h0 h20
              simpa [Nat.mul_assoc] using this
            · exact ih (den - 1) (by omega) w0 w1 (w2 - 1) (w3 - 1) (by omega) (by omega)
                (by omega) (by omega)
          rw [show den = (den - 1) + 1 by omega, Nat.pow_add, Nat.pow_one]
          refine Nat.le_trans (Nat.mul_le_mul hih hCD) (Nat.le_of_eq ?_)
          rw [pow_pred_mul C w2 (by omega), pow_pred_mul D w3 (by omega)]
          ac_rfl

theorem sound_FractionalCap : FractionalCap.Goal := by
  intro n db b weights den hcover
  obtain ⟨hpos, hlen, hv⟩ := hcover
  obtain ⟨w0, w1, w2, w3, rfl⟩ := list4_of_length4 weights hlen
  have hzip : pattern.atoms.zip [w0, w1, w2, w3] =
      [(⟨0, 0, 1⟩, w0), (⟨1, 0, 2⟩, w1), (⟨2, 1, 3⟩, w2), (⟨3, 2, 3⟩, w3)] := by
    simp [pattern, List.zip]
  have hv1 := hv 1 (by simp [pattern])
  have hv2 := hv 2 (by simp [pattern])
  have hv3 := hv 3 (by simp [pattern])
  rw [hzip] at hv1 hv2 hv3
  simp at hv1 hv2 hv3
  rw [show (fun r x y => if db r x y == 0 then 0 else 1) = bin db from rfl]
  have hcount : (reference pattern n (bin db) b).toNat = (satBindings pattern n db b).length := by
    rw [reference_bin_count pattern n db b]
    exact Int.ofNat_inj.mp (Int.toNat_of_nonneg (int_coe_nonneg _))
  rw [hcount]
  have hrhs : ((pattern.atoms.zip [w0, w1, w2, w3]).map (fun (a, w) =>
      support n db a pattern b ^ w)).prod =
      support n db ⟨0, 0, 1⟩ pattern b ^ w0 *
        (support n db ⟨1, 0, 2⟩ pattern b ^ w1 *
          (support n db ⟨2, 1, 3⟩ pattern b ^ w2 * support n db ⟨3, 2, 3⟩ pattern b ^ w3)) := by
    rw [hzip]
    simp
  rw [hrhs]
  have hL : ((satBindings pattern n db b).length : Int) = reference pattern n (bin db) b :=
    (reference_bin_count pattern n db b).symm
  have hS0 : (support n db ⟨0, 0, 1⟩ pattern b : Int) = kcA n db b :=
    support_eq_pin pattern n db b 0 0 1 (by simp [pattern]) (by simp [pattern])
  have hS1 : (support n db ⟨1, 0, 2⟩ pattern b : Int) = kcB n db b :=
    support_eq_pin pattern n db b 1 0 2 (by simp [pattern]) (by simp [pattern])
  have hS2 : (support n db ⟨2, 1, 3⟩ pattern b : Int) = triE n db 2 :=
    support_eq_triE pattern n db b 2 1 3 (by simp [pattern]) (by simp [pattern])
  have hS3 : (support n db ⟨3, 2, 3⟩ pattern b : Int) = triE n db 3 :=
    support_eq_triE pattern n db b 3 2 3 (by simp [pattern]) (by simp [pattern])
  have hp1 : (satBindings pattern n db b).length ≤
      support n db ⟨1, 0, 2⟩ pattern b * support n db ⟨2, 1, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS1, hS2]
    exact kc_R_le_BC n db b
  have hp2 : (satBindings pattern n db b).length ≤
      support n db ⟨0, 0, 1⟩ pattern b * support n db ⟨3, 2, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS0, hS3]
    exact kc_R_le_AD n db b
  have hp3 : (satBindings pattern n db b).length ≤
      support n db ⟨2, 1, 3⟩ pattern b * support n db ⟨3, 2, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS2, hS3]
    exact kc_R_le_CD n db b
  have hmain : (satBindings pattern n db b).length ^ den ≤
      support n db ⟨0, 0, 1⟩ pattern b ^ w0 * support n db ⟨1, 0, 2⟩ pattern b ^ w1 *
        support n db ⟨2, 1, 3⟩ pattern b ^ w2 * support n db ⟨3, 2, 3⟩ pattern b ^ w3 := by
    refine fc_kc _ _ _ _ _ hp1 hp2 hp3 den w0 w1 w2 w3 hpos ?_ ?_ ?_
    · omega
    · omega
    · omega
  refine Nat.le_trans hmain (Nat.le_of_eq ?_)
  ac_rfl
end KeywordCompany

namespace CastOverlap
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.CastOverlap
theorem sound_CollisionCorrection : CollisionCorrection.Goal :=
  fun n db b => collision_general pattern
    (by native_decide) (by native_decide) (by decide)
    (by intro x; simp [pattern, partitions, mobius, factorial, constOn, headOf] <;> omega)
    n db b
end CastOverlap

namespace PostDiamond
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.PostDiamond
private def pdC (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun v => bin db 0 (b 0) v)

private theorem pd_hshape (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b = rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3))))) := by
  simp [reference, pattern, integrate, value, put, rsum, bin]

private theorem pd_ref_le_CE (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ pdC n db b * triE n db 0 := by
  rw [pd_hshape]
  refine Int.le_trans (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3)))))
    (fun v1 => rsum n (fun v2 => rsum n (fun v3 => bin db 0 (b 0) v1 * bin db 0 v2 v3)))
    fun v1 _ => rsum_le n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3))))
      (fun v2 => rsum n (fun v3 => bin db 0 (b 0) v1 * bin db 0 v2 v3))
      fun v2 _ => rsum_le n (fun v3 =>
          bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3)))
        (fun v3 => bin db 0 (b 0) v1 * bin db 0 v2 v3) fun v3 _ => ?_) ?_
  · have hbc : (bin db 0 (b 0) v2 * bin db 0 v1 v3 : Int) ≤ 1 := by
      refine Int.le_trans (Int.mul_le_mul (bin_le_one db 0 (b 0) v2)
        (bin_le_one db 0 v1 v3) (bin_nonneg db 0 v1 v3) (by omega)) ?_
      simp
    have hA : 0 ≤ (bin db 0 (b 0) v1 : Int) := bin_nonneg db 0 (b 0) v1
    have hD : 0 ≤ (bin db 0 v2 v3 : Int) := bin_nonneg db 0 v2 v3
    have hBCD : 0 ≤ ((bin db 0 (b 0) v2 * bin db 0 v1 v3 : Int) * bin db 0 v2 v3) :=
      Int.mul_nonneg (Int.mul_nonneg (bin_nonneg db 0 (b 0) v2) (bin_nonneg db 0 v1 v3)) hD
    calc bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3))
        = bin db 0 (b 0) v1 * ((bin db 0 (b 0) v2 * bin db 0 v1 v3) * bin db 0 v2 v3) := by
            rw [Int.mul_assoc]
      _ ≤ bin db 0 (b 0) v1 * (1 * bin db 0 v2 v3) :=
          Int.mul_le_mul (Int.le_refl _)
            (Int.mul_le_mul hbc (Int.le_refl _) hD (by omega)) hBCD hA
      _ = bin db 0 (b 0) v1 * bin db 0 v2 v3 := by simp
  · have h1 : (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * bin db 0 v2 v3))) =
        (fun v1 => bin db 0 (b 0) v1 * rsum n (fun v2 => rsum n (fun v3 => bin db 0 v2 v3))) := by
      funext v1
      have h11 : (fun v2 => rsum n (fun v3 => bin db 0 (b 0) v1 * bin db 0 v2 v3))
          = (fun v2 => bin db 0 (b 0) v1 * rsum n (fun v3 => bin db 0 v2 v3)) := by
        funext v2
        exact rsum_const_mul n (bin db 0 (b 0) v1) (fun v3 => bin db 0 v2 v3)
      rw [h11]
      exact rsum_const_mul n (bin db 0 (b 0) v1) (fun v2 => rsum n (fun v3 => bin db 0 v2 v3))
    have h2 : rsum n (fun v2 => rsum n (fun v3 => bin db 0 v2 v3)) = triE n db 0 := rfl
    have h3 : rsum n (fun v1 => bin db 0 (b 0) v1) = pdC n db b := rfl
    calc rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
          bin db 0 (b 0) v1 * bin db 0 v2 v3)))
        = rsum n (fun v1 => bin db 0 (b 0) v1 * rsum n (fun v2 => rsum n (fun v3 =>
            bin db 0 v2 v3))) := congrArg (rsum n) h1
      _ = rsum n (fun v1 => bin db 0 (b 0) v1 * triE n db 0) :=
          congrArg (rsum n) (funext fun v1 => congrArg (fun t => bin db 0 (b 0) v1 * t) h2)
      _ = pdC n db b * triE n db 0 := by rw [rsum_mul_const, h3]
      _ ≤ pdC n db b * triE n db 0 := Int.le_refl _

private theorem pd_ref_le_EE (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ triE n db 0 * triE n db 0 := by
  rw [pd_hshape]
  refine Int.le_trans (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3)))))
    (fun v1 => rsum n (fun v2 => rsum n (fun v3 => bin db 0 v1 v3 * bin db 0 v2 v3)))
    fun v1 _ => rsum_le n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3))))
      (fun v2 => rsum n (fun v3 => bin db 0 v1 v3 * bin db 0 v2 v3))
      fun v2 _ => rsum_le n (fun v3 =>
          bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3)))
        (fun v3 => bin db 0 v1 v3 * bin db 0 v2 v3) fun v3 _ => ?_) ?_
  · have h12 : (bin db 0 (b 0) v1 * bin db 0 (b 0) v2 : Int) ≤ 1 := by
      refine Int.le_trans (Int.mul_le_mul (bin_le_one db 0 (b 0) v1) (bin_le_one db 0 (b 0) v2)
        (bin_nonneg db 0 (b 0) v2) (by omega)) ?_
      simp
    have h34 : 0 ≤ (bin db 0 v1 v3 * bin db 0 v2 v3 : Int) :=
      Int.mul_nonneg (bin_nonneg db 0 v1 v3) (bin_nonneg db 0 v2 v3)
    calc bin db 0 (b 0) v1 * (bin db 0 (b 0) v2 * (bin db 0 v1 v3 * bin db 0 v2 v3))
        = (bin db 0 (b 0) v1 * bin db 0 (b 0) v2) * (bin db 0 v1 v3 * bin db 0 v2 v3) := by
            rw [Int.mul_assoc]
      _ ≤ 1 * (bin db 0 v1 v3 * bin db 0 v2 v3) :=
          Int.mul_le_mul h12 (Int.le_refl _) h34 (by omega)
      _ = bin db 0 v1 v3 * bin db 0 v2 v3 := by simp
  · have hRle (v2 : Nat) (hv2 : v2 < n) :
      rsum n (fun w => bin db 0 w v2) ≤ triE n db 0 := by
      refine Int.le_trans (rsum_le n (fun w => bin db 0 w v2)
        (fun w => rsum n (fun u => bin db 0 w u))
        fun w _ => rsum_ge_single n v2 (fun u => bin db 0 w u) hv2 fun u _ => bin_nonneg db 0 w u) ?_
      exact Int.le_of_eq rfl
    have h1 : rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 0 v1 v3 * bin db 0 v2 v3)))
        = rsum n (fun v1 => rsum n (fun v3 =>
        bin db 0 v1 v3 * rsum n (fun v2 => bin db 0 v2 v3))) := by
      refine congrArg (rsum n) (funext fun v1 => ?_)
      exact (rsum_comm n n (fun v2 v3 => bin db 0 v1 v3 * bin db 0 v2 v3)).trans <|
        congrArg (rsum n) (funext fun v3 =>
          rsum_const_mul n (bin db 0 v1 v3) (fun v2 => bin db 0 v2 v3))
    have h2 : rsum n (fun v1 => rsum n (fun v3 => bin db 0 v1 v3 * rsum n (fun v2 => bin db 0 v2 v3)))
        ≤ rsum n (fun v1 => rsum n (fun v3 => bin db 0 v1 v3 * triE n db 0)) :=
      rsum_le n _ _ fun v1 h1 => rsum_le n _ _ fun v3 h3 =>
        Int.mul_le_mul (Int.le_refl _) (hRle v3 h3)
          (rsum_nonneg n (fun v2 => bin db 0 v2 v3) fun v2 _ => bin_nonneg db 0 v2 v3)
          (bin_nonneg db 0 v1 v3)
    have h3 : rsum n (fun v1 => rsum n (fun v3 => bin db 0 v1 v3 * triE n db 0))
        = triE n db 0 * triE n db 0 := by
      have h31 : (fun v1 => rsum n (fun v3 => bin db 0 v1 v3 * triE n db 0))
          = (fun v1 => rsum n (fun v3 => bin db 0 v1 v3) * triE n db 0) := by
        funext v1
        exact rsum_mul_const n (fun v3 => bin db 0 v1 v3) (triE n db 0)
      rw [h31, rsum_mul_const]
      have h32 : rsum n (fun v1 => rsum n (fun v3 => bin db 0 v1 v3)) = triE n db 0 := rfl
      rw [h32]
    rw [h1]
    refine Int.le_trans h2 (Int.le_of_eq h3)

theorem sound_FractionalCap : FractionalCap.Goal := by
  intro n db b weights den hcover
  obtain ⟨hpos, hlen, hv⟩ := hcover
  obtain ⟨w0, w1, w2, w3, rfl⟩ := list4_of_length4 weights hlen
  have hzip : pattern.atoms.zip [w0, w1, w2, w3] =
      [(⟨0, 0, 1⟩, w0), (⟨0, 0, 2⟩, w1), (⟨0, 1, 3⟩, w2), (⟨0, 2, 3⟩, w3)] := by
    simp [pattern, List.zip]
  have hv1 := hv 1 (by simp [pattern])
  have hv2 := hv 2 (by simp [pattern])
  have hv3 := hv 3 (by simp [pattern])
  rw [hzip] at hv1 hv2 hv3
  simp at hv1 hv2 hv3
  rw [show (fun r x y => if db r x y == 0 then 0 else 1) = bin db from rfl]
  have hcount : (reference pattern n (bin db) b).toNat = (satBindings pattern n db b).length := by
    rw [reference_bin_count pattern n db b]
    exact Int.ofNat_inj.mp (Int.toNat_of_nonneg (int_coe_nonneg _))
  rw [hcount]
  have hrhs : ((pattern.atoms.zip [w0, w1, w2, w3]).map (fun (a, w) =>
      support n db a pattern b ^ w)).prod =
      support n db ⟨0, 0, 1⟩ pattern b ^ w0 *
        (support n db ⟨0, 0, 2⟩ pattern b ^ w1 *
          (support n db ⟨0, 1, 3⟩ pattern b ^ w2 * support n db ⟨0, 2, 3⟩ pattern b ^ w3)) := by
    rw [hzip]
    simp
  rw [hrhs]
  rw [show support n db ⟨0, 0, 2⟩ pattern b = support n db ⟨0, 0, 1⟩ pattern b from rfl,
      show support n db ⟨0, 2, 3⟩ pattern b = support n db ⟨0, 1, 3⟩ pattern b from rfl]
  have hL : ((satBindings pattern n db b).length : Int) = reference pattern n (bin db) b :=
    (reference_bin_count pattern n db b).symm
  have hS0 : (support n db ⟨0, 0, 1⟩ pattern b : Int) = pdC n db b :=
    support_eq_pin pattern n db b 0 0 1 (by simp [pattern]) (by simp [pattern])
  have hS2 : (support n db ⟨0, 1, 3⟩ pattern b : Int) = triE n db 0 :=
    support_eq_triE pattern n db b 0 1 3 (by simp [pattern]) (by simp [pattern])
  have hp1 : (satBindings pattern n db b).length ≤
      support n db ⟨0, 0, 1⟩ pattern b * support n db ⟨0, 1, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS0, hS2]
    exact pd_ref_le_CE n db b
  have hp2 : (satBindings pattern n db b).length ≤
      support n db ⟨0, 1, 3⟩ pattern b * support n db ⟨0, 1, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS2]
    exact pd_ref_le_EE n db b
  have hmain : (satBindings pattern n db b).length ^ den ≤
      (support n db ⟨0, 0, 1⟩ pattern b) ^ (w0 + w1) *
        (support n db ⟨0, 1, 3⟩ pattern b) ^ (w2 + w3) := by
    refine fc_pd _ _ _ hp1 hp2 den (w0 + w1) (w2 + w3) hpos ?_ ?_
    · omega
    · omega
  refine Nat.le_trans hmain (Nat.le_of_eq ?_)
  rw [Nat.pow_add, Nat.pow_add]
  ac_rfl

end PostDiamond

namespace VoteBadge
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.VoteBadge
private theorem rsum_eq_zero_imp (n : Nat) (f : Nat → Int) (hnon : ∀ i, i < n → 0 ≤ f i)
    (h : rsum n f = 0) (i : Nat) (hi : i < n) : f i = 0 := by
  have hle : f i ≤ rsum n f := rsum_ge_single n i f hi hnon
  rw [h] at hle
  have hge : 0 ≤ f i := hnon i hi
  omega

private theorem list5_of_length5 {α : Type} (l : List α) (h : l.length = 5) :
    ∃ a b c d e, l = [a, b, c, d, e] := by
  cases l with
  | nil => simp at h
  | cons a l =>
    cases l with
    | nil => simp at h
    | cons b l =>
      cases l with
      | nil => simp at h
      | cons c l =>
        cases l with
        | nil => simp at h
        | cons d l =>
          cases l with
          | nil => simp at h
          | cons e l =>
            cases l with
            | nil => exact ⟨a, b, c, d, e, rfl⟩
            | cons f l => simp at h

private def vbA (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun y => bin db 0 (b 0) y)

private def vbD (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun y => bin db 3 (b 0) y)

private theorem vb_hshape (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b =
    rsum n (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 => rsum n (fun v1 =>
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v1 v3 *
        (bin db 3 (b 0) v4 * bin db 3 v4 v5)))))))) := by
  simp [reference, pattern, integrate, value, put, rsum, bin]

-- R ≤ triE 1 * triE 2 * triE 3
private theorem vb_R_le_K (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ triE n db 1 * triE n db 2 * triE n db 3 := by
  rw [vb_hshape]
  have hpt (v1 v2 v3 v4 v5 : Nat) :
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v1 v3 *
          (bin db 3 (b 0) v4 * bin db 3 v4 v5)))
      ≤ bin db 1 v1 v2 * (bin db 2 v1 v3 * bin db 3 v4 v5) := by
    have hc : 0 ≤ (bin db 1 v1 v2 : Int) := bin_nonneg db 1 v1 v2
    have he : 0 ≤ (bin db 2 v1 v3 : Int) := bin_nonneg db 2 v1 v3
    have hg : 0 ≤ (bin db 3 (b 0) v4 : Int) := bin_nonneg db 3 (b 0) v4
    have hh : 0 ≤ (bin db 3 v4 v5 : Int) := bin_nonneg db 3 v4 v5
    have hin : bin db 2 v1 v3 * (bin db 3 (b 0) v4 * bin db 3 v4 v5)
        ≤ bin db 2 v1 v3 * (1 * bin db 3 v4 v5) :=
      Int.mul_le_mul (Int.le_refl _)
        (Int.mul_le_mul (bin_le_one db 3 (b 0) v4) (Int.le_refl _) hh (by omega))
        (Int.mul_nonneg hg hh) he
    calc bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v1 v3 *
            (bin db 3 (b 0) v4 * bin db 3 v4 v5)))
        ≤ 1 * (bin db 1 v1 v2 * (bin db 2 v1 v3 * (bin db 3 (b 0) v4 * bin db 3 v4 v5))) :=
          Int.mul_le_mul (bin_le_one db 0 (b 0) v1) (Int.le_refl _)
            (Int.mul_nonneg hc (Int.mul_nonneg he (Int.mul_nonneg hg hh))) (by omega)
      _ = bin db 1 v1 v2 * (bin db 2 v1 v3 * (bin db 3 (b 0) v4 * bin db 3 v4 v5)) := by simp
      _ ≤ bin db 1 v1 v2 * (bin db 2 v1 v3 * (1 * bin db 3 v4 v5)) :=
          Int.mul_le_mul (Int.le_refl _) hin
            (Int.mul_nonneg he (Int.mul_nonneg hg hh)) hc
      _ = bin db 1 v1 v2 * (bin db 2 v1 v3 * bin db 3 v4 v5) := by simp
  have hstep : rsum n (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 =>
        rsum n (fun v1 => bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v1 v3 *
          (bin db 3 (b 0) v4 * bin db 3 v4 v5)))))))) ≤
      rsum n (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 =>
          rsum n (fun v1 => bin db 1 v1 v2 * (bin db 2 v1 v3 * bin db 3 v4 v5)))))) :=
    rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ => rsum_le n _ _ fun v5 _ =>
      rsum_le n _ _ fun v4 _ => rsum_le n _ _ fun v1 _ => hpt v1 v2 v3 v4 v5
  refine Int.le_trans hstep ?_
  refine Int.le_trans (Int.le_of_eq ?_) ?_
  · -- Σ_{v1} c·(e·h) = h · Σ_{v1} c·e ; pull h through Σ_{v4}, Σ_{v5}; ΣΣ h = triE3;
    -- pull triE3 through Σ_{v3}, Σ_{v2}
    rw [show (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 => rsum n (fun v1 =>
          bin db 1 v1 v2 * (bin db 2 v1 v3 * bin db 3 v4 v5))))))
        = (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 =>
            bin db 3 v4 v5 * rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3))))) by
          refine congrArg (rsum n) (funext fun v2 => congrArg (rsum n) (funext fun v3 =>
            congrArg (rsum n) (funext fun v5 => congrArg (rsum n) (funext fun v4 => ?_))))
          rw [show (fun v1 => bin db 1 v1 v2 * (bin db 2 v1 v3 * bin db 3 v4 v5))
              = (fun v1 => bin db 3 v4 v5 * (bin db 1 v1 v2 * bin db 2 v1 v3)) by
                funext v1
                simp [Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]]
          exact rsum_const_mul n (bin db 3 v4 v5)
            (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3)]
    rw [show (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 =>
          bin db 3 v4 v5 * rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3)))))
        = (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 => bin db 3 v4 v5) *
            rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3)))) by
          refine congrArg (rsum n) (funext fun v2 => congrArg (rsum n) (funext fun v3 =>
            congrArg (rsum n) (funext fun v5 => ?_)))
          exact rsum_mul_const n (fun v4 => bin db 3 v4 v5)
            (rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3)))]
    rw [show (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 => bin db 3 v4 v5) *
          rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3))))
        = (fun v2 => rsum n (fun v3 => rsum n (fun v5 => rsum n (fun v4 => bin db 3 v4 v5)) *
            rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3))) by
          refine congrArg (rsum n) (funext fun v2 => congrArg (rsum n) (funext fun v3 => ?_))
          exact rsum_mul_const n (fun v5 => rsum n (fun v4 => bin db 3 v4 v5))
            (rsum n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3)))]
    rw [show rsum n (fun v5 => rsum n (fun v4 => bin db 3 v4 v5)) = triE n db 3 from
        (rsum_comm n n (fun v4 v5 => bin db 3 v4 v5)).symm]
    rw [show (fun v2 => rsum n (fun v3 => triE n db 3 * rsum n (fun v1 =>
          bin db 1 v1 v2 * bin db 2 v1 v3)))
        = (fun v2 => triE n db 3 * rsum n (fun v3 => rsum n (fun v1 =>
            bin db 1 v1 v2 * bin db 2 v1 v3))) by
          funext v2
          exact rsum_const_mul n (triE n db 3) (fun v3 => rsum n (fun v1 =>
            bin db 1 v1 v2 * bin db 2 v1 v3))]
    rw [rsum_const_mul n (triE n db 3) (fun v2 => rsum n (fun v3 => rsum n (fun v1 =>
      bin db 1 v1 v2 * bin db 2 v1 v3)))]
  · -- triE3 · ΣΣ Σ c·e ≤ triE3 · (triE1 · triE2) = triE1 · triE2 · triE3
    have h7 : rsum n (fun v2 => rsum n (fun v3 => rsum n (fun v1 =>
        bin db 1 v1 v2 * bin db 2 v1 v3)))
        ≤ triE n db 1 * triE n db 2 := by
      refine Int.le_trans (rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ =>
          rsum_mul_le_mul_rsum n (fun v1 => bin db 1 v1 v2) (fun v1 => bin db 2 v1 v3)
            (fun v1 _ => bin_nonneg db 1 v1 v2) (fun v1 _ => bin_nonneg db 2 v1 v3)) ?_
      refine Int.le_of_eq ?_
      rw [show (fun v2 => rsum n (fun v3 => rsum n (fun v1 => bin db 1 v1 v2) *
            rsum n (fun v1 => bin db 2 v1 v3)))
          = (fun v2 => rsum n (fun v1 => bin db 1 v1 v2) * rsum n (fun v3 =>
              rsum n (fun v1 => bin db 2 v1 v3))) by
            funext v2
            exact rsum_const_mul n (rsum n (fun v1 => bin db 1 v1 v2))
              (fun v3 => rsum n (fun v1 => bin db 2 v1 v3))]
      rw [rsum_mul_const n (fun v2 => rsum n (fun v1 => bin db 1 v1 v2))
        (rsum n (fun v3 => rsum n (fun v1 => bin db 2 v1 v3)))]
      rw [show rsum n (fun v2 => rsum n (fun v1 => bin db 1 v1 v2)) = triE n db 1 from
          (rsum_comm n n (fun v1 v2 => bin db 1 v1 v2)).symm,
        show rsum n (fun v3 => rsum n (fun v1 => bin db 2 v1 v3)) = triE n db 2 from
          (rsum_comm n n (fun v1 v3 => bin db 2 v1 v3)).symm]
    refine Int.le_trans (Int.mul_le_mul (Int.le_refl (triE n db 3)) h7
      (rsum_nonneg n (fun v2 => rsum n (fun v3 => rsum n (fun v1 =>
          bin db 1 v1 v2 * bin db 2 v1 v3)))
        fun v2 _ => rsum_nonneg n (fun v3 => rsum n (fun v1 =>
          bin db 1 v1 v2 * bin db 2 v1 v3))
          fun v3 _ => rsum_nonneg n (fun v1 => bin db 1 v1 v2 * bin db 2 v1 v3)
            fun v1 _ => Int.mul_nonneg (bin_nonneg db 1 v1 v2) (bin_nonneg db 2 v1 v3))
      (triE_nonneg n db 3)) (Int.le_of_eq (Int.mul_comm _ _))

private theorem rsum_eq_zero_of (n : Nat) (f : Nat → Int) (h : ∀ i, i < n → f i = 0) :
    rsum n f = 0 := by
  apply Int.le_antisymm
  · rw [← rsum_const_zero n]
    exact rsum_le n f (fun _ => 0) fun i hi => Int.le_of_eq (h i hi)
  · exact rsum_nonneg n f fun i hi => Int.le_of_eq (h i hi).symm

private theorem vb_R_eq_zero_of_A (n : Nat) (db : DB) (b : Bind)
    (h : rsum n (fun y => bin db 0 (b 0) y) = 0) :
    (reference pattern n (bin db) b : Int) = 0 := by
  have hz : ∀ y, y < n → bin db 0 (b 0) y = 0 :=
    rsum_eq_zero_imp n _ (fun i hi => bin_nonneg db 0 (b 0) i) h
  rw [vb_hshape]
  refine rsum_eq_zero_of n _ fun v2 _ => rsum_eq_zero_of n _ fun v3 _ =>
    rsum_eq_zero_of n _ fun v5 _ => rsum_eq_zero_of n _ fun v4 _ =>
      rsum_eq_zero_of n _ fun v1 hv => by
        rw [hz v1 hv]
        simp

private theorem vb_R_eq_zero_of_D (n : Nat) (db : DB) (b : Bind)
    (h : rsum n (fun y => bin db 3 (b 0) y) = 0) :
    (reference pattern n (bin db) b : Int) = 0 := by
  have hz : ∀ y, y < n → bin db 3 (b 0) y = 0 :=
    rsum_eq_zero_imp n _ (fun i hi => bin_nonneg db 3 (b 0) i) h
  rw [vb_hshape]
  refine rsum_eq_zero_of n _ fun v2 _ => rsum_eq_zero_of n _ fun v3 _ =>
    rsum_eq_zero_of n _ fun v5 _ => rsum_eq_zero_of n _ fun v4 hv =>
      rsum_eq_zero_of n _ fun v1 _ => by
        rw [hz v4 hv]
        simp

theorem sound_FractionalCap : FractionalCap.Goal := by
  intro n db b weights den hcover
  obtain ⟨hpos, hlen, hv⟩ := hcover
  obtain ⟨w0, w1, w2, w3, w4, rfl⟩ := list5_of_length5 weights hlen
  have hzip : pattern.atoms.zip [w0, w1, w2, w3, w4] =
      [(⟨0, 0, 1⟩, w0), (⟨1, 1, 2⟩, w1), (⟨2, 1, 3⟩, w2), (⟨3, 0, 4⟩, w3),
        (⟨3, 4, 5⟩, w4)] := by
    simp [pattern, List.zip]
  have hv1 := hv 1 (by simp [pattern])
  have hv2 := hv 2 (by simp [pattern])
  have hv3 := hv 3 (by simp [pattern])
  have hv4 := hv 4 (by simp [pattern])
  have hv5 := hv 5 (by simp [pattern])
  rw [hzip] at hv1 hv2 hv3 hv4 hv5
  simp at hv1 hv2 hv3 hv4 hv5
  have hd1 : den ≤ w1 := by omega
  have hd2 : den ≤ w2 := by omega
  have hd4 : den ≤ w4 := by omega
  rw [show (fun r x y => if db r x y == 0 then 0 else 1) = bin db from rfl]
  have hcount : (reference pattern n (bin db) b).toNat = (satBindings pattern n db b).length := by
    rw [reference_bin_count pattern n db b]
    exact Int.ofNat_inj.mp (Int.toNat_of_nonneg (int_coe_nonneg _))
  rw [hcount]
  have hrhs : ((pattern.atoms.zip [w0, w1, w2, w3, w4]).map (fun (a, w) =>
      support n db a pattern b ^ w)).prod =
      support n db ⟨0, 0, 1⟩ pattern b ^ w0 *
        (support n db ⟨1, 1, 2⟩ pattern b ^ w1 *
          (support n db ⟨2, 1, 3⟩ pattern b ^ w2 *
            (support n db ⟨3, 0, 4⟩ pattern b ^ w3 * support n db ⟨3, 4, 5⟩ pattern b ^ w4))) := by
    rw [hzip]
    simp
  rw [hrhs]
  have hL : ((satBindings pattern n db b).length : Int) = reference pattern n (bin db) b :=
    (reference_bin_count pattern n db b).symm
  have hS0 : (support n db ⟨0, 0, 1⟩ pattern b : Int) = vbA n db b :=
    support_eq_pin pattern n db b 0 0 1 (by simp [pattern]) (by simp [pattern])
  have hS1 : (support n db ⟨1, 1, 2⟩ pattern b : Int) = triE n db 1 :=
    support_eq_triE pattern n db b 1 1 2 (by simp [pattern]) (by simp [pattern])
  have hS2 : (support n db ⟨2, 1, 3⟩ pattern b : Int) = triE n db 2 :=
    support_eq_triE pattern n db b 2 1 3 (by simp [pattern]) (by simp [pattern])
  have hS3 : (support n db ⟨3, 0, 4⟩ pattern b : Int) = vbD n db b :=
    support_eq_pin pattern n db b 3 0 4 (by simp [pattern]) (by simp [pattern])
  have hS4 : (support n db ⟨3, 4, 5⟩ pattern b : Int) = triE n db 3 :=
    support_eq_triE pattern n db b 3 4 5 (by simp [pattern]) (by simp [pattern])
  have hKNat : (satBindings pattern n db b).length ≤
      support n db ⟨1, 1, 2⟩ pattern b * support n db ⟨2, 1, 3⟩ pattern b *
        support n db ⟨3, 4, 5⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, Int.natCast_mul, hL, hS1, hS2, hS4]
    exact vb_R_le_K n db b
  by_cases hL0 : (satBindings pattern n db b).length = 0
  · rw [hL0, Nat.zero_pow hpos]
    exact Nat.zero_le _
  · have hLp : 0 < (satBindings pattern n db b).length := Nat.pos_of_ne_zero hL0
    have hS1p : 0 < support n db ⟨1, 1, 2⟩ pattern b := by
      by_cases h : support n db ⟨1, 1, 2⟩ pattern b = 0
      · rw [h, Nat.zero_mul, Nat.zero_mul] at hKNat
        omega
      exact Nat.pos_of_ne_zero h
    have hS2p : 0 < support n db ⟨2, 1, 3⟩ pattern b := by
      by_cases h : support n db ⟨2, 1, 3⟩ pattern b = 0
      · rw [h, Nat.mul_zero, Nat.zero_mul] at hKNat
        omega
      exact Nat.pos_of_ne_zero h
    have hS4p : 0 < support n db ⟨3, 4, 5⟩ pattern b := by
      by_cases h : support n db ⟨3, 4, 5⟩ pattern b = 0
      · rw [h, Nat.mul_zero] at hKNat
        omega
      exact Nat.pos_of_ne_zero h
    have hA0p : support n db ⟨0, 0, 1⟩ pattern b ≠ 0 := by
      intro hz
      have h0 : vbA n db b = 0 := by
        rw [← hS0, hz]
        simp
      have hRe : (reference pattern n (bin db) b : Int) = 0 := vb_R_eq_zero_of_A n db b h0
      exact hL0 (Int.ofNat_inj.mp (hL.trans hRe))
    have hD3p : support n db ⟨3, 0, 4⟩ pattern b ≠ 0 := by
      intro hz
      have h0 : vbD n db b = 0 := by
        rw [← hS3, hz]
        simp
      have hRe : (reference pattern n (bin db) b : Int) = 0 := vb_R_eq_zero_of_D n db b h0
      exact hL0 (Int.ofNat_inj.mp (hL.trans hRe))
    have ht1 : (support n db ⟨1, 1, 2⟩ pattern b)^den ≤ (support n db ⟨1, 1, 2⟩ pattern b)^w1 :=
      pow_mono_of_pos hS1p hd1
    have ht2 : (support n db ⟨2, 1, 3⟩ pattern b)^den ≤ (support n db ⟨2, 1, 3⟩ pattern b)^w2 :=
      pow_mono_of_pos hS2p hd2
    have ht4 : (support n db ⟨3, 4, 5⟩ pattern b)^den ≤ (support n db ⟨3, 4, 5⟩ pattern b)^w4 :=
      pow_mono_of_pos hS4p hd4
    have h2 : (support n db ⟨1, 1, 2⟩ pattern b * support n db ⟨2, 1, 3⟩ pattern b *
        support n db ⟨3, 4, 5⟩ pattern b)^den =
        (support n db ⟨1, 1, 2⟩ pattern b)^den * (support n db ⟨2, 1, 3⟩ pattern b)^den *
          (support n db ⟨3, 4, 5⟩ pattern b)^den := by
      rw [Nat.mul_pow, Nat.mul_pow]
    have h3 : (support n db ⟨1, 1, 2⟩ pattern b)^den * (support n db ⟨2, 1, 3⟩ pattern b)^den *
        (support n db ⟨3, 4, 5⟩ pattern b)^den ≤
        (support n db ⟨1, 1, 2⟩ pattern b)^w1 *
          ((support n db ⟨2, 1, 3⟩ pattern b)^w2 * (support n db ⟨3, 4, 5⟩ pattern b)^w4) := by
      rw [Nat.mul_assoc]
      exact Nat.mul_le_mul ht1 (Nat.mul_le_mul ht2 ht4)
    have h5 : (support n db ⟨1, 1, 2⟩ pattern b)^w1 *
        ((support n db ⟨2, 1, 3⟩ pattern b)^w2 * (support n db ⟨3, 4, 5⟩ pattern b)^w4) ≤
        (support n db ⟨0, 0, 1⟩ pattern b)^w0 *
          ((support n db ⟨1, 1, 2⟩ pattern b)^w1 *
            ((support n db ⟨2, 1, 3⟩ pattern b)^w2 *
              ((support n db ⟨3, 0, 4⟩ pattern b)^w3 * (support n db ⟨3, 4, 5⟩ pattern b)^w4))) := by
      have hA : 0 < (support n db ⟨0, 0, 1⟩ pattern b)^w0 := by
        refine Nat.pos_of_ne_zero ?_
        intro hz0
        rw [Nat.pow_eq_zero] at hz0
        exact hA0p hz0.1
      have hD : 1 ≤ (support n db ⟨3, 0, 4⟩ pattern b)^w3 :=
        Nat.one_le_pow w3 (support n db ⟨3, 0, 4⟩ pattern b) (Nat.pos_of_ne_zero hD3p)
      calc (support n db ⟨1, 1, 2⟩ pattern b)^w1 *
            ((support n db ⟨2, 1, 3⟩ pattern b)^w2 * (support n db ⟨3, 4, 5⟩ pattern b)^w4)
          _ = (support n db ⟨1, 1, 2⟩ pattern b)^w1 *
              ((support n db ⟨2, 1, 3⟩ pattern b)^w2 *
                (1 * (support n db ⟨3, 4, 5⟩ pattern b)^w4)) := by simp
          _ ≤ (support n db ⟨1, 1, 2⟩ pattern b)^w1 *
              ((support n db ⟨2, 1, 3⟩ pattern b)^w2 *
                ((support n db ⟨3, 0, 4⟩ pattern b)^w3 * (support n db ⟨3, 4, 5⟩ pattern b)^w4)) :=
              Nat.mul_le_mul (Nat.le_refl _)
                (Nat.mul_le_mul (Nat.le_refl _) (Nat.mul_le_mul hD (Nat.le_refl _)))
          _ ≤ (support n db ⟨0, 0, 1⟩ pattern b)^w0 *
              ((support n db ⟨1, 1, 2⟩ pattern b)^w1 *
                ((support n db ⟨2, 1, 3⟩ pattern b)^w2 *
                  ((support n db ⟨3, 0, 4⟩ pattern b)^w3 * (support n db ⟨3, 4, 5⟩ pattern b)^w4))) :=
              Nat.le_mul_of_pos_left _ hA
    have hsub : (satBindings pattern n db b).length ^ den ≤
        (support n db ⟨1, 1, 2⟩ pattern b)^w1 *
          ((support n db ⟨2, 1, 3⟩ pattern b)^w2 * (support n db ⟨3, 4, 5⟩ pattern b)^w4) := by
      refine Nat.le_trans (Nat.pow_le_pow_left hKNat den) ?_
      rw [h2]
      exact h3
    exact Nat.le_trans hsub h5
theorem sound_CollisionCorrection : CollisionCorrection.Goal :=
  fun n db b => collision_general pattern
    (by native_decide) (by native_decide) (by decide)
    (by intro x; simp [pattern, partitions, mobius, factorial, constOn, headOf] <;> by_cases h0 : x 2 = x 3 <;> by_cases h1 : x 2 = x 5 <;> by_cases h2 : x 2 = x 4 <;> by_cases h3 : x 2 = x 1 <;> by_cases h4 : x 3 = x 5 <;> by_cases h5 : x 3 = x 4 <;> by_cases h6 : x 3 = x 1 <;> by_cases h7 : x 5 = x 4 <;> by_cases h8 : x 5 = x 1 <;> by_cases h9 : x 4 = x 1 <;> simp_all (config := {decide := true}) [eq_comm])
    n db b
end VoteBadge

namespace ReplyCycle
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.ReplyCycle
theorem sound_CollisionCorrection : CollisionCorrection.Goal :=
  fun n db b => collision_general pattern
    (by native_decide) (by native_decide) (by decide)
    (by intro x; simp [pattern, partitions, mobius, factorial, constOn, headOf] <;> omega)
    n db b
end ReplyCycle

namespace FriendBridge
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.FriendBridge
private def fbA (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun y => bin db 0 (b 0) y)

private def fbD (n : Nat) (db : DB) (b : Bind) : Int :=
  rsum n (fun x => bin db 3 x (b 4))

private theorem fb_hshape (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b = rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))))) := by
  simp [reference, pattern, integrate, value, put, rsum, bin]

-- R ≤ fbA * triE 2
private theorem fb_R_le_AC (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ fbA n db b * triE n db 2 := by
  rw [fb_hshape]
  have hpt (v1 v2 v3 : Nat) :
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
      ≤ bin db 0 (b 0) v1 * bin db 2 v2 v3 := by
    have ha : 0 ≤ (bin db 0 (b 0) v1 : Int) := bin_nonneg db 0 (b 0) v1
    have hc : 0 ≤ (bin db 1 v1 v2 : Int) := bin_nonneg db 1 v1 v2
    have he : 0 ≤ (bin db 2 v2 v3 : Int) := bin_nonneg db 2 v2 v3
    have hg : 0 ≤ (bin db 3 v3 (b 4) : Int) := bin_nonneg db 3 v3 (b 4)
    have h1 : bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))
        ≤ 1 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)) :=
      Int.mul_le_mul (bin_le_one db 1 v1 v2) (Int.le_refl _)
        (Int.mul_nonneg he hg) (by omega)
    have h2 : bin db 2 v2 v3 * bin db 3 v3 (b 4) ≤ bin db 2 v2 v3 * 1 :=
      Int.mul_le_mul (Int.le_refl _) (bin_le_one db 3 v3 (b 4)) hg he
    have h3 : bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)) ≤ bin db 2 v2 v3 := by
      calc bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))
          ≤ 1 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)) := h1
        _ = bin db 2 v2 v3 * bin db 3 v3 (b 4) := by simp
        _ ≤ bin db 2 v2 v3 * 1 := h2
        _ = bin db 2 v2 v3 := by simp
    exact Int.mul_le_mul (Int.le_refl _) h3
      (Int.mul_nonneg hc (Int.mul_nonneg he hg)) ha
  have hstep : rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))))) ≤
      rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * bin db 2 v2 v3))) :=
    rsum_le n _ _ fun v1 _ => rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ => hpt v1 v2 v3
  refine Int.le_trans hstep ?_
  refine Int.le_of_eq ?_
  calc rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * bin db 2 v2 v3)))
      = rsum n (fun v1 => rsum n (fun v2 =>
          bin db 0 (b 0) v1 * rsum n (fun v3 => bin db 2 v2 v3))) := by
          refine congrArg (rsum n) (funext fun v1 => congrArg (rsum n) (funext fun v2 =>
            rsum_const_mul n (bin db 0 (b 0) v1) (fun v3 => bin db 2 v2 v3)))
    _ = rsum n (fun v1 => triE n db 2 * bin db 0 (b 0) v1) := by
          refine congrArg (rsum n) (funext fun v1 => ?_)
          rw [show (fun v2 => bin db 0 (b 0) v1 * rsum n (fun v3 => bin db 2 v2 v3))
              = (fun v2 => rsum n (fun v3 => bin db 2 v2 v3) * bin db 0 (b 0) v1) by
                funext v2; exact Int.mul_comm _ _]
          rw [rsum_mul_const n (fun v2 => rsum n (fun v3 => bin db 2 v2 v3))
            (bin db 0 (b 0) v1)]
          try rfl
    _ = triE n db 2 * fbA n db b :=
        rsum_const_mul n (triE n db 2) (fun v1 => bin db 0 (b 0) v1)
    _ = fbA n db b * triE n db 2 := by rw [Int.mul_comm]

-- R ≤ fbD * triE 1
private theorem fb_R_le_BD (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ fbD n db b * triE n db 1 := by
  rw [fb_hshape]
  have hpt (v1 v2 v3 : Nat) :
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
      ≤ bin db 1 v1 v2 * bin db 3 v3 (b 4) := by
    have ha : 0 ≤ (bin db 0 (b 0) v1 : Int) := bin_nonneg db 0 (b 0) v1
    have hc : 0 ≤ (bin db 1 v1 v2 : Int) := bin_nonneg db 1 v1 v2
    have he : 0 ≤ (bin db 2 v2 v3 : Int) := bin_nonneg db 2 v2 v3
    have hg : 0 ≤ (bin db 3 v3 (b 4) : Int) := bin_nonneg db 3 v3 (b 4)
    have h0 : bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
        ≤ 1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))) :=
      Int.mul_le_mul (bin_le_one db 0 (b 0) v1) (Int.le_refl _)
        (Int.mul_nonneg hc (Int.mul_nonneg he hg)) (by omega)
    have h2 : bin db 2 v2 v3 * bin db 3 v3 (b 4) ≤ 1 * bin db 3 v3 (b 4) :=
      Int.mul_le_mul (bin_le_one db 2 v2 v3) (Int.le_refl _) hg (by omega)
    calc bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
        ≤ 1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))) := h0
      _ = bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)) := by simp
      _ ≤ bin db 1 v1 v2 * (1 * bin db 3 v3 (b 4)) :=
          Int.mul_le_mul (Int.le_refl _) h2 (Int.mul_nonneg he hg) hc
      _ = bin db 1 v1 v2 * bin db 3 v3 (b 4) := by simp
  refine Int.le_trans
    (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))))))
      (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 1 v1 v2 * bin db 3 v3 (b 4))))
      (fun v1 _ => rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ => hpt v1 v2 v3)) ?_
  refine Int.le_of_eq ?_
  rw [show (fun v1 => rsum n (fun v2 => rsum n (fun v3 => bin db 1 v1 v2 * bin db 3 v3 (b 4))))
      = (fun v1 => rsum n (fun v2 => bin db 1 v1 v2 * fbD n db b)) by
        funext v1
        refine congrArg (rsum n) (funext fun v2 =>
          rsum_const_mul n (bin db 1 v1 v2) (fun v3 => bin db 3 v3 (b 4)))]
  rw [show (fun v1 => rsum n (fun v2 => bin db 1 v1 v2 * fbD n db b))
      = (fun v1 => rsum n (fun v2 => bin db 1 v1 v2) * fbD n db b) by
        funext v1
        exact rsum_mul_const n (fun v2 => bin db 1 v1 v2) (fbD n db b)]
  rw [rsum_mul_const n (fun v1 => rsum n (fun v2 => bin db 1 v1 v2)) (fbD n db b)]
  rw [Int.mul_comm]
  try rfl

private theorem fb_R_le_BC (n : Nat) (db : DB) (b : Bind) :
    (reference pattern n (bin db) b : Int) ≤ triE n db 1 * triE n db 2 := by
  rw [fb_hshape]
  have hpt (v1 v2 v3 : Nat) :
      bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
      ≤ bin db 1 v1 v2 * bin db 2 v2 v3 := by
    have ha : 0 ≤ (bin db 0 (b 0) v1 : Int) := bin_nonneg db 0 (b 0) v1
    have hc : 0 ≤ (bin db 1 v1 v2 : Int) := bin_nonneg db 1 v1 v2
    have he : 0 ≤ (bin db 2 v2 v3 : Int) := bin_nonneg db 2 v2 v3
    have hg : 0 ≤ (bin db 3 v3 (b 4) : Int) := bin_nonneg db 3 v3 (b 4)
    have h0 : bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
        ≤ 1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))) :=
      Int.mul_le_mul (bin_le_one db 0 (b 0) v1) (Int.le_refl _)
        (Int.mul_nonneg hc (Int.mul_nonneg he hg)) (by omega)
    have h2 : bin db 2 v2 v3 * bin db 3 v3 (b 4) ≤ bin db 2 v2 v3 * 1 :=
      Int.mul_le_mul (Int.le_refl _) (bin_le_one db 3 v3 (b 4)) hg he
    calc bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)))
        ≤ 1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))) := h0
      _ = bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4)) := by simp
      _ ≤ bin db 1 v1 v2 * (bin db 2 v2 v3 * 1) :=
          Int.mul_le_mul (Int.le_refl _) h2 (Int.mul_nonneg he hg) hc
      _ = bin db 1 v1 v2 * bin db 2 v2 v3 := by simp
  refine Int.le_trans
    (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 0 (b 0) v1 * (bin db 1 v1 v2 * (bin db 2 v2 v3 * bin db 3 v3 (b 4))))))
      (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 1 v1 v2 * bin db 2 v2 v3)))
      (fun v1 _ => rsum_le n _ _ fun v2 _ => rsum_le n _ _ fun v3 _ => hpt v1 v2 v3)) ?_
  have hrow (v2 : Nat) (hv2 : v2 < n) :
      rsum n (fun v3 => bin db 2 v2 v3) ≤ triE n db 2 :=
    rsum_ge_single n v2 (fun u => rsum n (fun v3 => bin db 2 u v3)) hv2
      fun u _ => rsum_nonneg n (fun v3 => bin db 2 u v3) fun v3 _ => bin_nonneg db 2 u v3
  refine Int.le_trans
    (rsum_le n (fun v1 => rsum n (fun v2 => rsum n (fun v3 =>
        bin db 1 v1 v2 * bin db 2 v2 v3)))
      (fun v1 => rsum n (fun v2 => bin db 1 v1 v2 * triE n db 2))
      (fun v1 _ => rsum_le n _ _ fun v2 hv2 =>
        Int.le_trans (Int.le_of_eq
          (rsum_const_mul n (bin db 1 v1 v2) (fun v3 => bin db 2 v2 v3)))
          (Int.mul_le_mul (Int.le_refl _) (hrow v2 hv2)
            (rsum_nonneg n (fun v3 => bin db 2 v2 v3) fun v3 _ => bin_nonneg db 2 v2 v3)
            (bin_nonneg db 1 v1 v2)))) ?_
  refine Int.le_of_eq ?_
  rw [show (fun v1 => rsum n (fun v2 => bin db 1 v1 v2 * triE n db 2))
      = (fun v1 => rsum n (fun v2 => bin db 1 v1 v2) * triE n db 2) by
        funext v1; exact rsum_mul_const n (fun v2 => bin db 1 v1 v2) (triE n db 2)]
  rw [rsum_mul_const n (fun v1 => rsum n (fun v2 => bin db 1 v1 v2)) (triE n db 2)]
  try rfl

private theorem fc_fb (T A B C D : Nat) (hAC : T ≤ A * C) (hBD : T ≤ B * D) (hBC : T ≤ B * C) :
    ∀ den w0 w1 w2 w3 : Nat, 0 < den → den ≤ w0 + w1 → den ≤ w1 + w2 → den ≤ w2 + w3 →
      T ^ den ≤ A ^ w0 * B ^ w1 * C ^ w2 * D ^ w3 := by
  intro den
  induction den using Nat.strongRecOn with
  | ind den ih =>
      intro w0 w1 w2 w3 hden h1 h2 h3
      rcases Nat.eq_zero_or_pos T with hT0 | hTp
      · rw [hT0, Nat.zero_pow (by omega)]
        exact Nat.zero_le _
      · have hA1 : 1 ≤ A := by
          rcases Nat.eq_zero_or_pos A with hz | hz
          · rw [hz, Nat.zero_mul] at hAC; omega
          · omega
        have hB1 : 1 ≤ B := by
          rcases Nat.eq_zero_or_pos B with hz | hz
          · rw [hz, Nat.zero_mul] at hBD; omega
          · omega
        have hC1 : 1 ≤ C := by
          rcases Nat.eq_zero_or_pos C with hz | hz
          · rw [hz, Nat.mul_zero] at hAC; omega
          · omega
        have hD1 : 1 ≤ D := by
          rcases Nat.eq_zero_or_pos D with hz | hz
          · rw [hz, Nat.mul_zero] at hBD; omega
          · omega
        have hcase :
            (w0 > 0 ∧ w2 > 0) ∨ (w1 > 0 ∧ w3 > 0) ∨ (w1 > 0 ∧ w2 > 0 ∧ w1 + w2 > den) := by omega
        rcases hcase with ⟨hw0, hw2⟩ | ⟨hw1, hw3⟩ | ⟨hw1, hw2, hsl⟩
        · -- AC move
          have hih : T ^ (den - 1) ≤
              A ^ (w0 - 1) * B ^ w1 * C ^ (w2 - 1) * D ^ w3 := by
            rcases Nat.eq_zero_or_pos (den - 1) with hz | hz
            · rw [hz, Nat.pow_zero]
              have ha : 1 ≤ A ^ (w0 - 1) := Nat.one_le_pow _ _ hA1
              have hb : 1 ≤ B ^ w1 := Nat.one_le_pow _ _ hB1
              have hc : 1 ≤ C ^ (w2 - 1) := Nat.one_le_pow _ _ hC1
              have hd : 1 ≤ D ^ w3 := Nat.one_le_pow _ _ hD1
              have h0 : (1 : Nat) * 1 ≤ A ^ (w0 - 1) * B ^ w1 := Nat.mul_le_mul ha hb
              have h20 : (1 : Nat) * 1 ≤ C ^ (w2 - 1) * D ^ w3 := Nat.mul_le_mul hc hd
              have := Nat.mul_le_mul h0 h20
              simpa [Nat.mul_assoc] using this
            · exact ih (den - 1) (by omega) (w0 - 1) w1 (w2 - 1) w3 (by omega) (by omega)
                (by omega) (by omega)
          rw [show den = (den - 1) + 1 by omega, Nat.pow_add, Nat.pow_one]
          refine Nat.le_trans (Nat.mul_le_mul hih hAC) (Nat.le_of_eq ?_)
          rw [pow_pred_mul A w0 (by omega), pow_pred_mul C w2 (by omega)]
          ac_rfl
        · -- BD move
          have hih : T ^ (den - 1) ≤
              A ^ w0 * B ^ (w1 - 1) * C ^ w2 * D ^ (w3 - 1) := by
            rcases Nat.eq_zero_or_pos (den - 1) with hz | hz
            · rw [hz, Nat.pow_zero]
              have ha : 1 ≤ A ^ w0 := Nat.one_le_pow _ _ hA1
              have hb : 1 ≤ B ^ (w1 - 1) := Nat.one_le_pow _ _ hB1
              have hc : 1 ≤ C ^ w2 := Nat.one_le_pow _ _ hC1
              have hd : 1 ≤ D ^ (w3 - 1) := Nat.one_le_pow _ _ hD1
              have h0 : (1 : Nat) * 1 ≤ A ^ w0 * B ^ (w1 - 1) := Nat.mul_le_mul ha hb
              have h20 : (1 : Nat) * 1 ≤ C ^ w2 * D ^ (w3 - 1) := Nat.mul_le_mul hc hd
              have := Nat.mul_le_mul h0 h20
              simpa [Nat.mul_assoc] using this
            · exact ih (den - 1) (by omega) w0 (w1 - 1) w2 (w3 - 1) (by omega) (by omega)
                (by omega) (by omega)
          rw [show den = (den - 1) + 1 by omega, Nat.pow_add, Nat.pow_one]
          refine Nat.le_trans (Nat.mul_le_mul hih hBD) (Nat.le_of_eq ?_)
          rw [pow_pred_mul B w1 (by omega), pow_pred_mul D w3 (by omega)]
          ac_rfl
        · -- BC move
          have hih : T ^ (den - 1) ≤
              A ^ w0 * B ^ (w1 - 1) * C ^ (w2 - 1) * D ^ w3 := by
            rcases Nat.eq_zero_or_pos (den - 1) with hz | hz
            · rw [hz, Nat.pow_zero]
              have ha : 1 ≤ A ^ w0 := Nat.one_le_pow _ _ hA1
              have hb : 1 ≤ B ^ (w1 - 1) := Nat.one_le_pow _ _ hB1
              have hc : 1 ≤ C ^ (w2 - 1) := Nat.one_le_pow _ _ hC1
              have hd : 1 ≤ D ^ w3 := Nat.one_le_pow _ _ hD1
              have h0 : (1 : Nat) * 1 ≤ A ^ w0 * B ^ (w1 - 1) := Nat.mul_le_mul ha hb
              have h20 : (1 : Nat) * 1 ≤ C ^ (w2 - 1) * D ^ w3 := Nat.mul_le_mul hc hd
              have := Nat.mul_le_mul h0 h20
              simpa [Nat.mul_assoc] using this
            · exact ih (den - 1) (by omega) w0 (w1 - 1) (w2 - 1) w3 (by omega) (by omega)
                (by omega) (by omega)
          rw [show den = (den - 1) + 1 by omega, Nat.pow_add, Nat.pow_one]
          refine Nat.le_trans (Nat.mul_le_mul hih hBC) (Nat.le_of_eq ?_)
          rw [pow_pred_mul B w1 (by omega), pow_pred_mul C w2 (by omega)]
          ac_rfl

theorem sound_FractionalCap : FractionalCap.Goal := by
  intro n db b weights den hcover
  obtain ⟨hpos, hlen, hv⟩ := hcover
  obtain ⟨w0, w1, w2, w3, rfl⟩ := list4_of_length4 weights hlen
  have hzip : pattern.atoms.zip [w0, w1, w2, w3] =
      [(⟨0, 0, 1⟩, w0), (⟨1, 1, 2⟩, w1), (⟨2, 2, 3⟩, w2), (⟨3, 3, 4⟩, w3)] := by
    simp [pattern, List.zip]
  have hv1 := hv 1 (by simp [pattern])
  have hv2 := hv 2 (by simp [pattern])
  have hv3 := hv 3 (by simp [pattern])
  rw [hzip] at hv1 hv2 hv3
  simp at hv1 hv2 hv3
  rw [show (fun r x y => if db r x y == 0 then 0 else 1) = bin db from rfl]
  have hcount : (reference pattern n (bin db) b).toNat = (satBindings pattern n db b).length := by
    rw [reference_bin_count pattern n db b]
    exact Int.ofNat_inj.mp (Int.toNat_of_nonneg (int_coe_nonneg _))
  rw [hcount]
  have hrhs : ((pattern.atoms.zip [w0, w1, w2, w3]).map (fun (a, w) =>
      support n db a pattern b ^ w)).prod =
      support n db ⟨0, 0, 1⟩ pattern b ^ w0 *
        (support n db ⟨1, 1, 2⟩ pattern b ^ w1 *
          (support n db ⟨2, 2, 3⟩ pattern b ^ w2 * support n db ⟨3, 3, 4⟩ pattern b ^ w3)) := by
    rw [hzip]
    simp
  rw [hrhs]
  have hL : ((satBindings pattern n db b).length : Int) = reference pattern n (bin db) b :=
    (reference_bin_count pattern n db b).symm
  have hS0 : (support n db ⟨0, 0, 1⟩ pattern b : Int) = fbA n db b :=
    support_eq_pin pattern n db b 0 0 1 (by simp [pattern]) (by simp [pattern])
  have hS1 : (support n db ⟨1, 1, 2⟩ pattern b : Int) = triE n db 1 :=
    support_eq_triE pattern n db b 1 1 2 (by simp [pattern]) (by simp [pattern])
  have hS2 : (support n db ⟨2, 2, 3⟩ pattern b : Int) = triE n db 2 :=
    support_eq_triE pattern n db b 2 2 3 (by simp [pattern]) (by simp [pattern])
  have hS3 : (support n db ⟨3, 3, 4⟩ pattern b : Int) = fbD n db b :=
    support_eq_pindst pattern n db b 3 3 4 (by simp [pattern]) (by simp [pattern])
  have hp1 : (satBindings pattern n db b).length ≤
      support n db ⟨0, 0, 1⟩ pattern b * support n db ⟨2, 2, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS0, hS2]
    exact fb_R_le_AC n db b
  have hp2 : (satBindings pattern n db b).length ≤
      support n db ⟨1, 1, 2⟩ pattern b * support n db ⟨3, 3, 4⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS1, hS3]
    have hbd := fb_R_le_BD n db b
    rw [Int.mul_comm] at hbd
    exact hbd
  have hp3 : (satBindings pattern n db b).length ≤
      support n db ⟨1, 1, 2⟩ pattern b * support n db ⟨2, 2, 3⟩ pattern b := by
    apply Int.ofNat_le.mp
    rw [Int.natCast_mul, hL, hS1, hS2]
    exact fb_R_le_BC n db b
  have hmain : (satBindings pattern n db b).length ^ den ≤
      support n db ⟨0, 0, 1⟩ pattern b ^ w0 * support n db ⟨1, 1, 2⟩ pattern b ^ w1 *
        support n db ⟨2, 2, 3⟩ pattern b ^ w2 * support n db ⟨3, 3, 4⟩ pattern b ^ w3 := by
    refine fc_fb _ _ _ _ _ hp1 hp2 hp3 den w0 w1 w2 w3 hpos ?_ ?_ ?_
    · omega
    · omega
    · omega
  refine Nat.le_trans hmain (Nat.le_of_eq ?_)
  ac_rfl
end FriendBridge

namespace ForumBowtie
open TinylambOpt.ResearchGoals.Atlas.JoinPlans.ForumBowtie
private theorem cover_decomp : ∀ den w0 w1 w2 w3 w4 w5 : Nat,
    den ≤ w0 + w1 → den ≤ w1 + w2 → den ≤ w3 + w4 → den ≤ w4 + w5 →
    den ≤ w0 + w2 + w3 + w5 →
    ∃ t1 t2 t3 t4 t5 t6 t7 s1 s4 : Nat,
      t1 + t2 + t3 + t4 + t5 + t6 + t7 + 2 * (s1 + s4) = den ∧
      (t1 + t6 + t7) + s4 ≤ w0 ∧
      (t1 + t2 + t3 + t4 + t5) + 2*s1 ≤ w1 ∧
      (t2 + t6 + t7) + s4 ≤ w2 ∧
      (t3 + t5 + t7) + s1 ≤ w3 ∧
      (t1 + t2 + t3 + t4 + t6) + 2*s4 ≤ w4 ∧
      (t4 + t5 + t7) + s1 ≤ w5 := by
  intro den
  induction den using Nat.strongRecOn with
  | ind den ih =>
      intro w0 w1 w2 w3 w4 w5 h0 h1 h3 h4 h5
      by_cases hden : den = 0
      · subst den
        exact ⟨0,0,0,0,0,0,0,0,0, by simp⟩
      by_cases hC1 : 0 < w0 ∧ 0 < w1 ∧ 0 < w4 ∧ den + 1 ≤ w0 + w1
      · rcases ih (den-1) (by omega) (w0-1) (w1-1) w2 w3 (w4-1) w5
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1+1,t2,t3,t4,t5,t6,t7,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hC2 : 0 < w1 ∧ 0 < w4 ∧ 0 < w2 ∧ den + 1 ≤ w1 + w2
      · rcases ih (den-1) (by omega) w0 (w1-1) (w2-1) w3 (w4-1) w5
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2+1,t3,t4,t5,t6,t7,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hC3 : 0 < w1 ∧ 0 < w4 ∧ 0 < w3 ∧ den + 1 ≤ w3 + w4
      · rcases ih (den-1) (by omega) w0 (w1-1) w2 (w3-1) (w4-1) w5
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3+1,t4,t5,t6,t7,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hC4 : 0 < w1 ∧ 0 < w4 ∧ 0 < w5 ∧ den + 1 ≤ w4 + w5
      · rcases ih (den-1) (by omega) w0 (w1-1) w2 w3 (w4-1) (w5-1)
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3,t4+1,t5,t6,t7,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hC5 : 0 < w1 ∧ 0 < w3 ∧ 0 < w5 ∧ den + 1 ≤ w0 + w2 + w3 + w5
      · rcases ih (den-1) (by omega) w0 (w1-1) w2 (w3-1) w4 (w5-1)
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3,t4,t5+1,t6,t7,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hC6 : 0 < w0 ∧ 0 < w2 ∧ 0 < w4 ∧ den + 1 ≤ w0 + w2 + w3 + w5
      · rcases ih (den-1) (by omega) (w0-1) w1 (w2-1) w3 (w4-1) w5
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3,t4,t5,t6+1,t7,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hC7 : 0 < w0 ∧ 0 < w2 ∧ 0 < w3 ∧ 0 < w5 ∧ den + 3 ≤ w0 + w2 + w3 + w5
      · rcases ih (den-1) (by omega) (w0-1) w1 (w2-1) (w3-1) w4 (w5-1)
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3,t4,t5,t6,t7+1,s1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hS1 : 2 ≤ den ∧ 2 ≤ w1 ∧ 0 < w3 ∧ 0 < w4 ∧ 0 < w5
      · rcases ih (den-2) (by omega) w0 (w1-2) w2 (w3-1) (w4-1) (w5-1)
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3,t4,t5,t6,t7,s1+1,s4,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hS4 : 2 ≤ den ∧ 2 ≤ w4 ∧ 0 < w0 ∧ 0 < w1 ∧ 0 < w2
      · rcases ih (den-2) (by omega) (w0-1) (w1-1) (w2-1) w3 (w4-2) w5
          (by omega) (by omega) (by omega) (by omega) (by omega)
          with ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4,hs,hu0,hu1,hu2,hu3,hu4,hu5⟩
        refine ⟨t1,t2,t3,t4,t5,t6,t7,s1,s4+1,?_,?_,?_,?_,?_,?_,?_⟩ <;> omega
      by_cases hp0 : 0 < w0 <;>
      by_cases hp1 : 0 < w1 <;>
      by_cases hp2 : 0 < w2 <;>
      by_cases hp3 : 0 < w3 <;>
      by_cases hp4 : 0 < w4 <;>
      by_cases hp5 : 0 < w5 <;>
      simp [hp0, hp1, hp2, hp3, hp4, hp5] at hC1 hC2 hC3 hC4 hC5 hC6 hC7 hS1 hS4 <;> omega

/-! ---------- finite sums ---------- -/

private theorem reference_shape (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b =
      rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v4 => rsum n (fun v3 => rsum n (fun v0 =>
        bin db 0 v0 v1 * (bin db 1 v1 v2 * (bin db 2 v2 v0 *
        (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))))))) := by
  simp [reference, pattern, integrate, value, put, rsum, bin]

private def T1 (n : Nat) (db : DB) (u : Nat) : Int :=
  rsum n (fun x => rsum n (fun y => bin db 0 u x * (bin db 1 x y * bin db 2 y u)))

private def T2 (n : Nat) (db : DB) (u : Nat) : Int :=
  rsum n (fun v => rsum n (fun w => bin db 0 u v * (bin db 1 v w * bin db 2 w u)))

private def Nbow (n : Nat) (db : DB) : Int := rsum n (fun u => T1 n db u * T2 n db u)

private theorem factor_four (n : Nat) (A B : Nat → Nat → Int) :
    rsum n (fun a => rsum n (fun b => rsum n (fun c => rsum n (fun d => A a b * B c d)))) =
      (rsum n (fun a => rsum n (fun b => A a b))) *
      (rsum n (fun c => rsum n (fun d => B c d))) := by
  let K : Int := rsum n (fun c => rsum n (fun d => B c d))
  have hinner : ∀ a b, rsum n (fun c => rsum n (fun d => A a b * B c d)) = A a b * K := by
    intro a b
    dsimp only [K]
    calc
      rsum n (fun c => rsum n (fun d => A a b * B c d))
          = rsum n (fun c => A a b * rsum n (fun d => B c d)) := by
              apply rsum_congr; intro c hc
              rw [rsum_const_mul]
      _ = A a b * rsum n (fun c => rsum n (fun d => B c d)) := by
              rw [rsum_const_mul]
  have h1 : rsum n (fun a => rsum n (fun b => rsum n (fun c => rsum n (fun d => A a b * B c d)))) =
      rsum n (fun a => rsum n (fun b => A a b * K)) := by
    apply rsum_congr; intro a ha
    apply rsum_congr; intro b hb
    exact hinner a b
  rw [h1]
  have h2 : rsum n (fun a => rsum n (fun b => A a b * K)) =
      rsum n (fun a => (rsum n (fun b => A a b)) * K) := by
    apply rsum_congr; intro a ha
    rw [rsum_mul_const]
  rw [h2]
  rw [rsum_mul_const]

private theorem sum_T2_eq_triT (n : Nat) (db : DB) :
    rsum n (fun u => T2 n db u) = triT n db 0 1 2 := by
  dsimp only [T2, triT]
  apply rsum_congr
  intro u hu
  apply rsum_congr
  intro v hv
  apply rsum_congr
  intro w hw
  ac_rfl

private theorem reference_bin_bow (n : Nat) (db : DB) (b : Bind) :
    reference pattern n (bin db) b = Nbow n db := by
  rw [reference_shape n db b]
  dsimp only [Nbow, T1, T2]
  calc
    rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v4 => rsum n (fun v3 => rsum n (fun v0 =>
        bin db 0 v0 v1 * (bin db 1 v1 v2 * (bin db 2 v2 v0 *
        (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0)))))))))
      = rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v4 => rsum n (fun v0 => rsum n (fun v3 =>
          bin db 0 v0 v1 * (bin db 1 v1 v2 * (bin db 2 v2 v0 *
          (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))))))) := by
          apply rsum_congr; intro v1 h1
          apply rsum_congr; intro v2 h2
          apply rsum_congr; intro v4 h4
          rw [rsum_comm]
    _ = rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v0 => rsum n (fun v4 => rsum n (fun v3 =>
          bin db 0 v0 v1 * (bin db 1 v1 v2 * (bin db 2 v2 v0 *
          (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))))))) := by
          apply rsum_congr; intro v1 h1
          apply rsum_congr; intro v2 h2
          rw [rsum_comm]
    _ = rsum n (fun v1 => rsum n (fun v0 => rsum n (fun v2 => rsum n (fun v4 => rsum n (fun v3 =>
          bin db 0 v0 v1 * (bin db 1 v1 v2 * (bin db 2 v2 v0 *
          (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))))))) := by
          apply rsum_congr; intro v1 h1
          rw [rsum_comm]
    _ = rsum n (fun v0 => rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v4 => rsum n (fun v3 =>
          bin db 0 v0 v1 * (bin db 1 v1 v2 * (bin db 2 v2 v0 *
          (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))))))) := by
          rw [rsum_comm]
    _ = rsum n (fun v0 => rsum n (fun v1 => rsum n (fun v2 => rsum n (fun v4 => rsum n (fun v3 =>
          (bin db 0 v0 v1 * (bin db 1 v1 v2 * bin db 2 v2 v0)) *
          (bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))))) := by
          apply rsum_congr; intro v0 h0
          apply rsum_congr; intro v1 h1
          apply rsum_congr; intro v2 h2
          apply rsum_congr; intro v4 h4
          apply rsum_congr; intro v3 h3
          ac_rfl
    _ = rsum n (fun v0 =>
          (rsum n (fun v1 => rsum n (fun v2 => bin db 0 v0 v1 * (bin db 1 v1 v2 * bin db 2 v2 v0)))) *
          (rsum n (fun v4 => rsum n (fun v3 => bin db 0 v0 v3 * (bin db 1 v3 v4 * bin db 2 v4 v0))))) := by
          apply rsum_congr; intro v0 h0
          rw [factor_four]
    _ = rsum n (fun v0 => T1 n db v0 * T2 n db v0) := by
          apply rsum_congr; intro v0 h0
          congr 1
          dsimp only [T2]
          rw [rsum_comm]

private theorem T1_nonneg (n : Nat) (db : DB) (u : Nat) : 0 ≤ T1 n db u := by
  dsimp only [T1]
  apply rsum_nonneg; intro x hx
  apply rsum_nonneg; intro y hy
  exact Int.mul_nonneg (bin_nonneg db 0 u x)
    (Int.mul_nonneg (bin_nonneg db 1 x y) (bin_nonneg db 2 y u))

private theorem T2_nonneg (n : Nat) (db : DB) (u : Nat) : 0 ≤ T2 n db u := by
  dsimp only [T2]
  apply rsum_nonneg; intro v hv
  apply rsum_nonneg; intro w hw
  exact Int.mul_nonneg (bin_nonneg db 0 u v)
    (Int.mul_nonneg (bin_nonneg db 1 v w) (bin_nonneg db 2 w u))

private theorem Nbow_nonneg (n : Nat) (db : DB) : 0 ≤ Nbow n db := by
  dsimp only [Nbow]
  apply rsum_nonneg; intro u hu
  exact Int.mul_nonneg (T1_nonneg n db u) (T2_nonneg n db u)

private theorem T1_le_triE1 (n : Nat) (db : DB) (u : Nat) : T1 n db u ≤ triE n db 1 := by
  have hpt : ∀ x y, bin db 0 u x * (bin db 1 x y * bin db 2 y u) ≤ bin db 1 x y := by
    intro x y
    have h0 : 0 ≤ bin db 0 u x := bin_nonneg db 0 u x
    have h0le : bin db 0 u x ≤ 1 := bin_le_one db 0 u x
    have h2 : 0 ≤ bin db 2 y u := bin_nonneg db 2 y u
    have h2le : bin db 2 y u ≤ 1 := bin_le_one db 2 y u
    have h1 : 0 ≤ bin db 1 x y := bin_nonneg db 1 x y
    have hprod : bin db 0 u x * bin db 2 y u ≤ 1 := by
      have hh := Int.mul_le_mul h0le h2le h2 (by omega : (0 : Int) ≤ 1)
      simpa using hh
    have hprod0 : 0 ≤ bin db 0 u x * bin db 2 y u := Int.mul_nonneg h0 h2
    have hh := Int.mul_le_mul (Int.le_refl (bin db 1 x y)) hprod hprod0 h1
    calc
      bin db 0 u x * (bin db 1 x y * bin db 2 y u)
          = bin db 1 x y * (bin db 0 u x * bin db 2 y u) := by ac_rfl
      _ ≤ bin db 1 x y * 1 := hh
      _ = bin db 1 x y := by rw [Int.mul_one]
  dsimp only [T1, triE]
  calc
    rsum n (fun x => rsum n (fun y => bin db 0 u x * (bin db 1 x y * bin db 2 y u)))
        ≤ rsum n (fun x => rsum n (fun y => bin db 1 x y)) := by
            apply rsum_le; intro x hx
            apply rsum_le; intro y hy
            exact hpt x y
    _ = rsum n (fun x => rsum n (fun y => bin db 1 x y)) := rfl

private theorem T2_le_triE1 (n : Nat) (db : DB) (u : Nat) : T2 n db u ≤ triE n db 1 := by
  have hpt : ∀ v w, bin db 0 u v * (bin db 1 v w * bin db 2 w u) ≤ bin db 1 v w := by
    intro v w
    have h0 : 0 ≤ bin db 0 u v := bin_nonneg db 0 u v
    have h0le : bin db 0 u v ≤ 1 := bin_le_one db 0 u v
    have h2 : 0 ≤ bin db 2 w u := bin_nonneg db 2 w u
    have h2le : bin db 2 w u ≤ 1 := bin_le_one db 2 w u
    have h1 : 0 ≤ bin db 1 v w := bin_nonneg db 1 v w
    have hprod : bin db 0 u v * bin db 2 w u ≤ 1 := by
      have hh := Int.mul_le_mul h0le h2le h2 (by omega : (0 : Int) ≤ 1)
      simpa using hh
    have hprod0 : 0 ≤ bin db 0 u v * bin db 2 w u := Int.mul_nonneg h0 h2
    have hh := Int.mul_le_mul (Int.le_refl (bin db 1 v w)) hprod hprod0 h1
    calc
      bin db 0 u v * (bin db 1 v w * bin db 2 w u)
          = bin db 1 v w * (bin db 0 u v * bin db 2 w u) := by ac_rfl
      _ ≤ bin db 1 v w * 1 := hh
      _ = bin db 1 v w := by rw [Int.mul_one]
  dsimp only [T2, triE]
  apply rsum_le; intro v hv
  apply rsum_le; intro w hw
  exact hpt v w

private theorem bow_sq (n : Nat) (db : DB) :
    Nbow n db ^ 2 ≤ triE n db 0 * triE n db 1 ^ 3 * triE n db 2 := by
  have htri := triangle_sq n db 0 1 2
  let Tri : Int := triT n db 0 1 2
  have hTri_nonneg : 0 ≤ Tri := by
    dsimp only [Tri]
    rw [← sum_T2_eq_triT n db]
    apply rsum_nonneg; intro u hu
    exact T2_nonneg n db u
  have hNle : Nbow n db ≤ triE n db 1 * Tri := by
    calc
      Nbow n db = rsum n (fun u => T1 n db u * T2 n db u) := rfl
      _ ≤ rsum n (fun u => triE n db 1 * T2 n db u) := by
          apply rsum_le; intro u hu
          exact Int.mul_le_mul (T1_le_triE1 n db u) (Int.le_refl (T2 n db u))
            (T2_nonneg n db u) (triE_nonneg n db 1)
      _ = triE n db 1 * rsum n (fun u => T2 n db u) := by
          rw [rsum_const_mul]
      _ = triE n db 1 * Tri := by
          dsimp only [Tri]
          rw [sum_T2_eq_triT]
  have hNle2 : Nbow n db ^ 2 ≤ (triE n db 1 * Tri) ^ 2 := by
    have hn := Nbow_nonneg n db
    have hr : 0 ≤ triE n db 1 * Tri := Int.mul_nonneg (triE_nonneg n db 1) hTri_nonneg
    have h := Int.mul_le_mul hNle hNle hn hr
    have hp1 : Nbow n db ^ 2 = Nbow n db * Nbow n db := by
      rw [Int.pow_succ, Int.pow_one]
    have hp2 : (triE n db 1 * Tri) ^ 2 = (triE n db 1 * Tri) * (triE n db 1 * Tri) := by
      rw [Int.pow_succ, Int.pow_one]
    rw [hp1, hp2]
    exact h
  have htri' : Tri ^ 2 ≤ triE n db 0 * triE n db 1 * triE n db 2 := by
    dsimp only [Tri]
    exact htri
  have hE1sq_nonneg : 0 ≤ triE n db 1 ^ 2 := Int.sq_nonneg _
  have hmul := Int.mul_le_mul (Int.le_refl (triE n db 1 ^ 2)) htri'
    (Int.sq_nonneg Tri) hE1sq_nonneg
  calc
    Nbow n db ^ 2 ≤ (triE n db 1 * Tri) ^ 2 := hNle2
    _ = (triE n db 1 ^ 2) * (Tri ^ 2) := by grind
    _ ≤ (triE n db 1 ^ 2) * (triE n db 0 * triE n db 1 * triE n db 2) := hmul
    _ = triE n db 0 * triE n db 1 ^ 3 * triE n db 2 := by grind


private def a0 : Atom := ⟨0, 0, 1⟩
private def a1 : Atom := ⟨1, 1, 2⟩
private def a2 : Atom := ⟨2, 2, 0⟩
private def a3 : Atom := ⟨0, 0, 3⟩
private def a4 : Atom := ⟨1, 3, 4⟩
private def a5 : Atom := ⟨2, 4, 0⟩

private def C1 : List Atom := [a0, a1, a4]
private def C2 : List Atom := [a1, a4, a2]
private def C3 : List Atom := [a1, a4, a3]
private def C4 : List Atom := [a1, a4, a5]
private def C5 : List Atom := [a1, a3, a5]
private def C6 : List Atom := [a0, a2, a4]
private def C7 : List Atom := [a0, a2, a3, a5]

private theorem cover_C1 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C1, a.src = v ∨ a.dst = v := by
  native_decide
private theorem cover_C2 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C2, a.src = v ∨ a.dst = v := by
  native_decide
private theorem cover_C3 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C3, a.src = v ∨ a.dst = v := by
  native_decide
private theorem cover_C4 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C4, a.src = v ∨ a.dst = v := by
  native_decide
private theorem cover_C5 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C5, a.src = v ∨ a.dst = v := by
  native_decide
private theorem cover_C6 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C6, a.src = v ∨ a.dst = v := by
  native_decide
private theorem cover_C7 : ∀ v ∈ pattern.freeVars, ∃ a ∈ C7, a.src = v ∨ a.dst = v := by
  native_decide
private theorem atoms_C1 : ∀ a ∈ C1, a ∈ pattern.atoms := by
  intro a ha; simp [C1, a0, a1, a4] at ha ⊢
  rcases ha with rfl | rfl | rfl <;> simp [pattern]
private theorem atoms_C2 : ∀ a ∈ C2, a ∈ pattern.atoms := by
  intro a ha; simp [C2, a1, a4, a2] at ha ⊢
  rcases ha with rfl | rfl | rfl <;> simp [pattern]
private theorem atoms_C3 : ∀ a ∈ C3, a ∈ pattern.atoms := by
  intro a ha; simp [C3, a1, a4, a3] at ha ⊢
  rcases ha with rfl | rfl | rfl <;> simp [pattern]
private theorem atoms_C4 : ∀ a ∈ C4, a ∈ pattern.atoms := by
  intro a ha; simp [C4, a1, a4, a5] at ha ⊢
  rcases ha with rfl | rfl | rfl <;> simp [pattern]
private theorem atoms_C5 : ∀ a ∈ C5, a ∈ pattern.atoms := by
  intro a ha; simp [C5, a1, a3, a5] at ha ⊢
  rcases ha with rfl | rfl | rfl <;> simp [pattern]
private theorem atoms_C6 : ∀ a ∈ C6, a ∈ pattern.atoms := by
  intro a ha; simp [C6, a0, a2, a4] at ha ⊢
  rcases ha with rfl | rfl | rfl <;> simp [pattern]
private theorem atoms_C7 : ∀ a ∈ C7, a ∈ pattern.atoms := by
  intro a ha; simp [C7, a0, a2, a3, a5] at ha ⊢
  rcases ha with rfl | rfl | rfl | rfl <;> simp [pattern]
private theorem fv_nodup : pattern.freeVars.Nodup := by native_decide

private theorem list6_of_length6 {α : Type} (l : List α) (h : l.length = 6) :
    ∃ a b c d e f, l = [a, b, c, d, e, f] := by
  cases l with
  | nil => simp at h
  | cons a l =>
    cases l with
    | nil => simp at h
    | cons b l =>
      cases l with
      | nil => simp at h
      | cons c l =>
        cases l with
        | nil => simp at h
        | cons d l =>
          cases l with
          | nil => simp at h
          | cons e l =>
            cases l with
            | nil => simp at h
            | cons f l =>
              cases l with
              | nil => exact ⟨a, b, c, d, e, f, rfl⟩
              | cons g l => simp at h


private theorem bow_sq_nat (n : Nat) (db : DB) (b : Bind) :
    let L : Nat := (satBindings pattern n db b).length
    let S0 := support n db a0 pattern b
    let S1 := support n db a1 pattern b
    let S2 := support n db a2 pattern b
    let S3 := support n db a3 pattern b
    let S4 := support n db a4 pattern b
    let S5 := support n db a5 pattern b
    L ^ 2 ≤ S1 ^ 2 * S3 * S4 * S5 ∧ L ^ 2 ≤ S0 * S1 * S2 * S4 ^ 2 := by
  dsimp only
  let L : Nat := (satBindings pattern n db b).length
  let S0 := support n db a0 pattern b
  let S1 := support n db a1 pattern b
  let S2 := support n db a2 pattern b
  let S3 := support n db a3 pattern b
  let S4 := support n db a4 pattern b
  let S5 := support n db a5 pattern b
  change L ^ 2 ≤ S1 ^ 2 * S3 * S4 * S5 ∧ L ^ 2 ≤ S0 * S1 * S2 * S4 ^ 2
  have hL : (L : Int) = Nbow n db := by
    dsimp only [L]
    rw [← reference_bin_count pattern n db b, reference_bin_bow]
  have hS0 : (S0 : Int) = triE n db 0 := by
    dsimp only [S0, a0]
    exact support_eq_triE pattern n db b 0 0 1 (by simp [pattern]) (by simp [pattern])
  have hS1 : (S1 : Int) = triE n db 1 := by
    dsimp only [S1, a1]
    exact support_eq_triE pattern n db b 1 1 2 (by simp [pattern]) (by simp [pattern])
  have hS2 : (S2 : Int) = triE n db 2 := by
    dsimp only [S2, a2]
    exact support_eq_triE pattern n db b 2 2 0 (by simp [pattern]) (by simp [pattern])
  have hS3 : (S3 : Int) = triE n db 0 := by
    dsimp only [S3, a3]
    exact support_eq_triE pattern n db b 0 0 3 (by simp [pattern]) (by simp [pattern])
  have hS4 : (S4 : Int) = triE n db 1 := by
    dsimp only [S4, a4]
    exact support_eq_triE pattern n db b 1 3 4 (by simp [pattern]) (by simp [pattern])
  have hS5 : (S5 : Int) = triE n db 2 := by
    dsimp only [S5, a5]
    exact support_eq_triE pattern n db b 2 4 0 (by simp [pattern]) (by simp [pattern])
  have hbsq := bow_sq n db
  rw [← hL] at hbsq
  have hnat : L ^ 2 ≤ S0 * S1 * S2 * S4 ^ 2 := by
    apply Int.ofNat_le.mp
    simp only [Int.natCast_pow, Int.natCast_mul]
    rw [hS0, hS1, hS2, hS4]
    grind
  have hnat' : L ^ 2 ≤ S1 ^ 2 * S3 * S4 * S5 := by
    apply Int.ofNat_le.mp
    simp only [Int.natCast_pow, Int.natCast_mul]
    rw [hS1, hS3, hS4, hS5]
    grind
  exact ⟨hnat', hnat⟩


theorem sound_FractionalCap :
    TinylambOpt.ResearchGoals.Atlas.JoinPlans.ForumBowtie.FractionalCap.Goal := by
  intro n db b weights den hcov
  rcases hcov with ⟨hdenpos, hlen, hc⟩
  rcases list6_of_length6 weights (by simpa [pattern] using hlen) with
    ⟨w0, w1, w2, w3, w4, w5, rfl⟩
  have h0 : den ≤ w0 + w2 + w3 + w5 := by
    have hh := hc 0 (by simp [pattern])
    simp [pattern] at hh
    omega
  have h1 : den ≤ w0 + w1 := by
    have hh := hc 1 (by simp [pattern])
    simp [pattern] at hh
    omega
  have h2 : den ≤ w1 + w2 := by
    have hh := hc 2 (by simp [pattern])
    simp [pattern] at hh
    omega
  have h3 : den ≤ w3 + w4 := by
    have hh := hc 3 (by simp [pattern])
    simp [pattern] at hh
    omega
  have h4 : den ≤ w4 + w5 := by
    have hh := hc 4 (by simp [pattern])
    simp [pattern] at hh
    omega
  rcases cover_decomp den w0 w1 w2 w3 w4 w5 h1 h2 h3 h4 h0 with
    ⟨t1, t2, t3, t4, t5, t6, t7, s1, s4, hs, hu0, hu1, hu2, hu3, hu4, hu5⟩
  let S0 := support n db a0 pattern b
  let S1 := support n db a1 pattern b
  let S2 := support n db a2 pattern b
  let S3 := support n db a3 pattern b
  let S4 := support n db a4 pattern b
  let S5 := support n db a5 pattern b
  let L := (satBindings pattern n db b).length
  have hb1 : L ≤ S0 * S1 * S4 := by
    dsimp only [L, S0, S1, S4]
    simpa [C1, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C1 cover_C1 atoms_C1 fv_nodup)
  have hb2 : L ≤ S1 * S4 * S2 := by
    dsimp only [L, S1, S4, S2]
    simpa [C2, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C2 cover_C2 atoms_C2 fv_nodup)
  have hb3 : L ≤ S1 * S4 * S3 := by
    dsimp only [L, S1, S4, S3]
    simpa [C3, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C3 cover_C3 atoms_C3 fv_nodup)
  have hb4 : L ≤ S1 * S4 * S5 := by
    dsimp only [L, S1, S4, S5]
    simpa [C4, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C4 cover_C4 atoms_C4 fv_nodup)
  have hb5 : L ≤ S1 * S3 * S5 := by
    dsimp only [L, S1, S3, S5]
    simpa [C5, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C5 cover_C5 atoms_C5 fv_nodup)
  have hb6 : L ≤ S0 * S2 * S4 := by
    dsimp only [L, S0, S2, S4]
    simpa [C6, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C6 cover_C6 atoms_C6 fv_nodup)
  have hb7 : L ≤ S0 * S2 * S3 * S5 := by
    dsimp only [L, S0, S2, S3, S5]
    simpa [C7, Nat.mul_assoc] using
      (ordinary_cover_bound pattern n db b C7 cover_C7 atoms_C7 fv_nodup)
  have hsq := bow_sq_nat n db b
  dsimp only at hsq
  have hsq1 : L ^ 2 ≤ S1 ^ 2 * S3 * S4 * S5 := by
    simpa [L, S1, S3, S4, S5] using hsq.1
  have hsq4 : L ^ 2 ≤ S0 * S1 * S2 * S4 ^ 2 := by
    simpa [L, S0, S1, S2, S4] using hsq.2
  have href : (reference pattern n (fun r x y => if db r x y == 0 then 0 else 1) b).toNat = L := by
    have hbin : (fun r x y : Nat => if db r x y == 0 then (0 : Int) else 1) = bin db := by
      funext r x y
      simp [bin, beq_iff_eq]
    rw [hbin]
    dsimp only [L]
    exact congrArg Int.toNat (reference_bin_count pattern n db b)
  have hRHS :
      ((pattern.atoms.zip [w0, w1, w2, w3, w4, w5]).map
        (fun (a, w) => support n db a pattern b ^ w)).prod =
      S0 ^ w0 * S1 ^ w1 * S2 ^ w2 * S3 ^ w3 * S4 ^ w4 * S5 ^ w5 := by
    simp [pattern, S0, S1, S2, S3, S4, S5, a0, a1, a2, a3, a4, a5, Nat.mul_assoc]
  rw [href, hRHS]
  by_cases hL0 : L = 0
  · rw [hL0]
    simp [Nat.zero_pow hdenpos]
  · have hLpos : 0 < L := Nat.pos_of_ne_zero hL0
    have hSpos : ∀ a ∈ pattern.atoms, 0 < support n db a pattern b := by
      intro a ha
      have hlenpos : 0 < (satBindings pattern n db b).length := by simpa [L] using hLpos
      obtain ⟨x, hx⟩ := List.exists_mem_of_ne_nil _ ((List.length_pos_iff).mp hlenpos)
      have hxbind : x ∈ bindings n pattern.freeVars b := (List.mem_filter.mp hx).1
      have hsat : satisfies pattern (bin db) x = true := (List.mem_filter.mp hx).2
      have hnz : db a.rel (x a.src) (x a.dst) != 0 := by
        have hall : pattern.atoms.all (fun t => value (bin db) t x != 0) = true := hsat
        simpa [value, bin, beq_iff_eq] using (List.all_eq_true.mp hall a ha)
      have hmemsl := supportList_mem pattern n db b a x hxbind hnz
      have hslne : supportList pattern n db b a ≠ [] := by
        intro hnil
        have hnot : (x a.src, x a.dst) ∉ supportList pattern n db b a := by simp [hnil]
        exact hnot hmemsl
      have hslpos : 0 < (supportList pattern n db b a).length :=
        (List.length_pos_iff).mpr hslne
      rw [supportList_length] at hslpos
      exact hslpos
    have hS0p : 0 < S0 := by dsimp only [S0]; exact hSpos a0 (by simp [a0, pattern])
    have hS1p : 0 < S1 := by dsimp only [S1]; exact hSpos a1 (by simp [a1, pattern])
    have hS2p : 0 < S2 := by dsimp only [S2]; exact hSpos a2 (by simp [a2, pattern])
    have hS3p : 0 < S3 := by dsimp only [S3]; exact hSpos a3 (by simp [a3, pattern])
    have hS4p : 0 < S4 := by dsimp only [S4]; exact hSpos a4 (by simp [a4, pattern])
    have hS5p : 0 < S5 := by dsimp only [S5]; exact hSpos a5 (by simp [a5, pattern])
    let U0 := (t1 + t6 + t7) + s4
    let U1 := (t1 + t2 + t3 + t4 + t5) + 2*s1
    let U2 := (t2 + t6 + t7) + s4
    let U3 := (t3 + t5 + t7) + s1
    let U4 := (t1 + t2 + t3 + t4 + t6) + 2*s4
    let U5 := (t4 + t5 + t7) + s1
    have hU0 : U0 ≤ w0 := by dsimp only [U0]; exact hu0
    have hU1 : U1 ≤ w1 := by dsimp only [U1]; exact hu1
    have hU2 : U2 ≤ w2 := by dsimp only [U2]; exact hu2
    have hU3 : U3 ≤ w3 := by dsimp only [U3]; exact hu3
    have hU4 : U4 ≤ w4 := by dsimp only [U4]; exact hu4
    have hU5 : U5 ≤ w5 := by dsimp only [U5]; exact hu5
    have hbig : L ^ den ≤ S0 ^ U0 * S1 ^ U1 * S2 ^ U2 * S3 ^ U3 * S4 ^ U4 * S5 ^ U5 := by
      have h1p := Nat.pow_le_pow_left hb1 t1
      have h2p := Nat.pow_le_pow_left hb2 t2
      have h3p := Nat.pow_le_pow_left hb3 t3
      have h4p := Nat.pow_le_pow_left hb4 t4
      have h5p := Nat.pow_le_pow_left hb5 t5
      have h6p := Nat.pow_le_pow_left hb6 t6
      have h7p := Nat.pow_le_pow_left hb7 t7
      have hsp1 := Nat.pow_le_pow_left hsq1 s1
      have hsp4 := Nat.pow_le_pow_left hsq4 s4
      have hpoweq : L ^ den = L ^ (t1 + t2 + t3 + t4 + t5 + t6 + t7) * (L ^ 2) ^ s1 * (L ^ 2) ^ s4 := by
        rw [show den = (t1 + t2 + t3 + t4 + t5 + t6 + t7) + 2*s1 + 2*s4 by omega]
        rw [Nat.pow_add, Nat.pow_add]
        rw [Nat.pow_mul, Nat.pow_mul]
      rw [hpoweq]
      have hm1 := Nat.mul_le_mul h1p h2p
      have hm2 := Nat.mul_le_mul hm1 h3p
      have hm3 := Nat.mul_le_mul hm2 h4p
      have hm4 := Nat.mul_le_mul hm3 h5p
      have hm5 := Nat.mul_le_mul hm4 h6p
      have hm6 := Nat.mul_le_mul hm5 h7p
      have hm7 := Nat.mul_le_mul hm6 hsp1
      have hm8 := Nat.mul_le_mul hm7 hsp4
      have hR : (S0 * S1 * S4) ^ t1 * (S1 * S4 * S2) ^ t2 * (S1 * S4 * S3) ^ t3 *
          (S1 * S4 * S5) ^ t4 * (S1 * S3 * S5) ^ t5 * (S0 * S2 * S4) ^ t6 *
          (S0 * S2 * S3 * S5) ^ t7 * (S1 ^ 2 * S3 * S4 * S5) ^ s1 *
          (S0 * S1 * S2 * S4 ^ 2) ^ s4 =
        S0 ^ U0 * S1 ^ U1 * S2 ^ U2 * S3 ^ U3 * S4 ^ U4 * S5 ^ U5 := by
        dsimp only [U0, U1, U2, U3, U4, U5]
        simp only [Nat.mul_pow, Nat.pow_add]
        ac_rfl
      rw [hR] at hm8
      exact hm8
    have hfinal : S0 ^ U0 * S1 ^ U1 * S2 ^ U2 * S3 ^ U3 * S4 ^ U4 * S5 ^ U5 ≤
        S0 ^ w0 * S1 ^ w1 * S2 ^ w2 * S3 ^ w3 * S4 ^ w4 * S5 ^ w5 := by
      have hp0 := pow_mono_of_pos hS0p hU0
      have hp1 := pow_mono_of_pos hS1p hU1
      have hp2 := pow_mono_of_pos hS2p hU2
      have hp3 := pow_mono_of_pos hS3p hU3
      have hp4 := pow_mono_of_pos hS4p hU4
      have hp5 := pow_mono_of_pos hS5p hU5
      have hm1 := Nat.mul_le_mul hp0 hp1
      have hm2 := Nat.mul_le_mul hm1 hp2
      have hm3 := Nat.mul_le_mul hm2 hp3
      have hm4 := Nat.mul_le_mul hm3 hp4
      exact Nat.mul_le_mul hm4 hp5
    exact Nat.le_trans hbig hfinal

theorem sound_CollisionCorrection : CollisionCorrection.Goal :=
  fun n db b => collision_general pattern
    (by native_decide) (by native_decide) (by decide)
    (by intro x; simp [pattern, partitions, mobius, factorial, constOn, headOf] <;> by_cases h0 : x 1 = x 2 <;> by_cases h1 : x 1 = x 4 <;> by_cases h2 : x 1 = x 3 <;> by_cases h3 : x 1 = x 0 <;> by_cases h4 : x 2 = x 4 <;> by_cases h5 : x 2 = x 3 <;> by_cases h6 : x 2 = x 0 <;> by_cases h7 : x 4 = x 3 <;> by_cases h8 : x 4 = x 0 <;> by_cases h9 : x 3 = x 0 <;> simp_all (config := {decide := true}) [eq_comm])
    n db b
end ForumBowtie

end TinylambOpt.ResearchProofs.Atlas.JoinPlans_WorkA
