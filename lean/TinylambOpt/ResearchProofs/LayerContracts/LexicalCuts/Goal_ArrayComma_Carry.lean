import TinylambOpt.ResearchGoals.LayerContracts.LexicalCuts
import TinylambOpt.ResearchProofs.LayerContracts.LexicalCuts.Common

/-!
The SQL frontend can scan input in chunks when its carried lexical state preserves
delimiter recognition across chunk boundaries.

Proved

- `ArrayComma.Carry` — Carry lexical state and shift all offsets to split an arbitrary
  input chunk.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000

namespace TinylambOpt.ResearchProofs.LayerContracts.LexicalCuts.Goal_ArrayComma_Carry

open TinylambOpt.ResearchGoals.LayerContracts.LexicalCuts
open TinylambOpt.ResearchProofs.LayerContracts.LexicalCuts.Common

theorem sound : ArrayComma.Carry.Goal := by
  exact Common.carry_general ArrayComma.model

end TinylambOpt.ResearchProofs.LayerContracts.LexicalCuts.Goal_ArrayComma_Carry
