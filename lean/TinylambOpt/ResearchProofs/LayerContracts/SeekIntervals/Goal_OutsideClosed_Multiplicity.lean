open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Specifics

theorem sound : OutsideClosed.Multiplicity.Goal := by
  exact Common.multiplicity_of_exact OutsideClosed.model Cores.outsideClosed_exact Cores.outsideClosed_sep

end TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_OutsideClosed_Multiplicity
