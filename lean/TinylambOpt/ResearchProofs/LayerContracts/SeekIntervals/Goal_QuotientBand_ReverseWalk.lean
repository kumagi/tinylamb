/-!
An index range plan must cover every qualifying key and preserve any gaps excluded by
the SQL predicate.

Proved

- `QuotientBand.ReverseWalk` — Descending index iteration can reverse both the seek
  order and each local scan.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000

namespace TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_QuotientBand_ReverseWalk

open TinylambOpt.ResearchGoals.LayerContracts.SeekIntervals
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Common
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Cores
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Specifics

theorem sound : QuotientBand.ReverseWalk.Goal := by
  exact Common.reverseWalk_of_exact QuotientBand.model Cores.quotientBand_exact Cores.quotientBand_sep

end TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_QuotientBand_ReverseWalk
