/-!
An index range plan must cover every qualifying key and preserve any gaps excluded by
the SQL predicate.

Proved

- `NotEqual.ExactCoverage` — Sum of span widths gives the exact qualifying domain
  population.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000

namespace TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_NotEqual_ExactCoverage

open TinylambOpt.ResearchGoals.LayerContracts.SeekIntervals
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Common
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Cores
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Specifics

theorem sound : NotEqual.ExactCoverage.Goal := by
  exact Common.coverage_of_exact NotEqual.model Cores.notEqual_exact Cores.notEqual_sep

end TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_NotEqual_ExactCoverage
