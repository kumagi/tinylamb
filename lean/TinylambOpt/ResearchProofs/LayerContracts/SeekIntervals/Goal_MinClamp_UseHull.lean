/-!
An index range plan must cover every qualifying key and preserve any gaps excluded by
the SQL predicate.

Proved

- `MinClamp.UseHull` — Can multiple seeks be replaced by one seek with no residual
  filter?
-/

set_option maxHeartbeats 0
set_option maxRecDepth 10000

namespace TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_MinClamp_UseHull

open TinylambOpt.ResearchGoals.LayerContracts.SeekIntervals
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Common
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Cores
open TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Specifics

theorem sound : MinClamp.UseHull.Goal := by
  exact Common.useHull_of_exact_single MinClamp.model Cores.minClamp_exact Cores.minClamp_single

end TinylambOpt.ResearchProofs.LayerContracts.SeekIntervals.Goal_MinClamp_UseHull
