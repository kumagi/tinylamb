import Std.Tactic

/-!
# ASCII fast path for LIKE patterns containing `_`

This module models the UTF-8 aware `_` of `EscapedLikeMatch` and the ASCII
fast path generated by the native LIKE compiler.

Three evaluators are defined over byte strings (`Byte = Nat`):

* `ByteLikeRef` is the reference byte-level matcher: `_` consumes one *whole*
  UTF-8 character, whose byte width is `charWidth` (the `Utf8SequenceLength`
  of the C++ code, clamped at the end of the string);
* `ByteLikeFast` is the generated ASCII fast path: every character is assumed
  to be one byte, so `_` consumes exactly one byte;
* `CharLike` is the reference matcher over decoded character chunks produced
  by `splitUtf8`, where `_` consumes exactly one character by construction.

The main theorem shows that on an all-ASCII region the three evaluators
agree, so a fast path that emits a one-byte `_` is semantically identical to
the reference.  A non-ASCII lead byte always has width greater than one,
hence an implementation that consumes only its first byte and then re-enters
the reference matcher would resume in the middle of a character; the correct
deoptimization policy is to fall back to `ByteLikeRef` on the whole row, which
`OptimizedLike` models and `optimized_preserves_result` proves to be
result-preserving.  `%` retry positions are part of the matcher state in all
three definitions (the `%` token is retained while the suffix is re-tried),
so leaving the fast path does not lose backtracking state.

Sufficient hypotheses (checked by the C++ implementation): binary collation,
non-NULL input, escape interpretation already applied, the region is entirely
ASCII (`∀ b ∈ v, b < 128`) for the fast path, and character boundaries are
respected when re-entering the reference matcher (the fallback restarts from
the row head).

C++ realization: `common/literal_like_pattern.hpp` (`EscapedLikeMatch`,
`Utf8SequenceLength`) and the diamond/ASCII fast path of `expression/jit.cpp`.
-/

namespace TinylambOpt.LikeUnderscore

abbrev Byte := Nat

/-- Byte width of a UTF-8 lead byte (`Utf8SequenceLength` in C++). -/
def utf8Len (b : Byte) : Nat :=
  if b < 128 then 1 else if b < 194 then 1 else if b < 224 then 2
  else if b < 240 then 3 else if b ≤ 244 then 4 else 1

theorem utf8Len_pos (b : Byte) : 0 < utf8Len b := by
  unfold utf8Len
  grind

theorem ascii_width_one (b : Byte) (h : b < 128) : utf8Len b = 1 := by
  simp [utf8Len, h]

theorem nonascii_width_gt_one (b : Nat) (lo : 194 ≤ b) (hi : b ≤ 244) :
    1 < utf8Len b := by unfold utf8Len; grind

/-- Width of the first character of `b :: bs`, clamped to the bytes present. -/
def charWidth (b : Byte) (bs : List Byte) : Nat := min (utf8Len b) (bs.length + 1)

theorem charWidth_pos (b : Byte) (bs : List Byte) : 0 < charWidth b bs := by
  dsimp [charWidth]
  exact Nat.lt_min.mpr ⟨utf8Len_pos b, by omega⟩

/-- Decode a byte string into UTF-8 character chunks. -/
def splitUtf8 (v : List Byte) : List (List Byte) :=
  match v with
  | [] => []
  | b :: bs => (b :: bs).take (charWidth b bs) :: splitUtf8 (bs.drop (charWidth b bs - 1))
termination_by v.length
decreasing_by
  dsimp
  simp only [List.length_drop]
  have := charWidth_pos b bs
  omega

theorem splitUtf8_ascii_cons (b : Byte) (bs : List Byte) (h : b < 128) :
    splitUtf8 (b :: bs) = [b] :: splitUtf8 bs := by
  simp [splitUtf8, charWidth, utf8Len, h]

/-- On an ASCII region each character is exactly one byte, so the decoder is
    the singleton map; in particular every resume offset is a character
    boundary. -/
theorem splitUtf8_ascii (v : List Byte) (hv : ∀ b ∈ v, b < 128) :
    splitUtf8 v = v.map (fun b => [b]) := by
  induction v with
  | nil => simp [splitUtf8]
  | cons b bs ih =>
      have hb : b < 128 := hv b (by simp)
      have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
      simp [splitUtf8_ascii_cons b bs hb, ih hbs]

/-- LIKE tokens after escape interpretation.  `lit` is a single byte; a
    multi-byte literal is represented by consecutive `lit` tokens. -/
inductive Tok where
  | lit : Byte → Tok
  | under : Tok
  | percent : Tok
deriving DecidableEq

/-- Generated ASCII fast path: `_` consumes one byte. -/
def ByteLikeFast (v : List Byte) (p : List Tok) : Bool :=
  match p with
  | [] => v.isEmpty
  | Tok.percent :: rest =>
      ByteLikeFast v rest || (match v with | [] => false | _ :: vs => ByteLikeFast vs (Tok.percent :: rest))
  | Tok.under :: rest => match v with | [] => false | _ :: vs => ByteLikeFast vs rest
  | Tok.lit c :: rest => match v with | b :: bs => (b == c) && ByteLikeFast bs rest | [] => false
termination_by (p.length, v.length)
decreasing_by all_goals simp_all <;> omega

/-- Reference byte-level matcher: `_` consumes one whole UTF-8 character. -/
def ByteLikeRef (v : List Byte) (p : List Tok) : Bool :=
  match p with
  | [] => v.isEmpty
  | Tok.percent :: rest =>
      ByteLikeRef v rest || (match v with | [] => false | b :: bs => ByteLikeRef (bs.drop (charWidth b bs - 1)) (Tok.percent :: rest))
  | Tok.under :: rest => match v with
      | [] => false
      | b :: bs => ByteLikeRef ((b :: bs).drop (charWidth b bs)) rest
  | Tok.lit c :: rest => match v with | b :: bs => (b == c) && ByteLikeRef bs rest | [] => false
termination_by (p.length, v.length)
decreasing_by
  all_goals
    simp only [List.length_cons]
    rw [Prod.lex_def]
    simp_all [List.length_drop] <;> omega

/-- Reference matcher over decoded characters: `_` consumes one character. -/
def CharLike (v : List (List Byte)) (p : List Tok) : Bool :=
  match p with
  | [] => v.isEmpty
  | Tok.percent :: rest =>
      CharLike v rest || (match v with | [] => false | _ :: vs => CharLike vs (Tok.percent :: rest))
  | Tok.under :: rest => match v with | [] => false | _ :: vs => CharLike vs rest
  | Tok.lit c :: rest => match v with | w :: vs => (w == [c]) && CharLike vs rest | [] => false
termination_by (p.length, v.length)
decreasing_by all_goals simp_all <;> omega

/-- On an ASCII region the byte-level reference and the fast path coincide. -/
theorem byteRef_eq_fast (v : List Byte) (p : List Tok) (hv : ∀ b ∈ v, b < 128) :
    ByteLikeRef v p = ByteLikeFast v p := by
  induction p generalizing v with
  | nil => simp [ByteLikeRef, ByteLikeFast]
  | cons t p' ihp =>
      cases t with
      | lit c =>
          cases v with
          | nil => simp [ByteLikeRef, ByteLikeFast]
          | cons b bs =>
              have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
              simp [ByteLikeRef, ByteLikeFast, ihp bs hbs]
      | under =>
          cases v with
          | nil => simp [ByteLikeRef, ByteLikeFast]
          | cons b bs =>
              have hb : b < 128 := hv b (by simp)
              have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
              have hn : charWidth b bs = 1 := by simp [charWidth, utf8Len, hb]
              have hd : (b :: bs).drop (charWidth b bs) = bs := by simp [hn]
              simp [ByteLikeRef, ByteLikeFast, hd, ihp bs hbs]
      | percent =>
          revert hv
          induction v with
          | nil =>
              intro hv
              have hz := ihp [] hv
              simp [ByteLikeRef, ByteLikeFast, hz]
          | cons b bs ihv =>
              intro hv
              have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
              have hz_full := ihp (b :: bs) hv
              have hpct := ihv hbs
              have hb : b < 128 := hv b (by simp)
              simp [ByteLikeRef, ByteLikeFast, hz_full, hpct, charWidth, utf8Len, hb]

/-- On an ASCII region the fast path and the character-level reference agree;
    in particular a fast-path `_` consumes exactly the one character `[b]`. -/
theorem fast_eq_char (v : List Byte) (p : List Tok) (hv : ∀ b ∈ v, b < 128) :
    ByteLikeFast v p = CharLike (splitUtf8 v) p := by
  induction p generalizing v with
  | nil =>
      have hs := splitUtf8_ascii v hv
      simp [ByteLikeFast, CharLike, hs]
  | cons t p' ihp =>
      cases t with
      | lit c =>
          cases v with
          | nil => simp [ByteLikeFast, CharLike, splitUtf8]
          | cons b bs =>
              have hb : b < 128 := hv b (by simp)
              have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
              have hs := splitUtf8_ascii_cons b bs hb
              have htail := ihp bs hbs
              simp [ByteLikeFast, CharLike, hs, htail]
      | under =>
          cases v with
          | nil => simp [ByteLikeFast, CharLike, splitUtf8]
          | cons b bs =>
              have hb : b < 128 := hv b (by simp)
              have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
              have hs := splitUtf8_ascii_cons b bs hb
              have htail := ihp bs hbs
              simp [ByteLikeFast, CharLike, hs, htail]
      | percent =>
          revert hv
          induction v with
          | nil =>
              intro hv
              have hz := ihp [] hv
              simp [ByteLikeFast, CharLike, splitUtf8, hz]
          | cons b bs ihv =>
              intro hv
              have hb : b < 128 := hv b (by simp)
              have hbs : ∀ x ∈ bs, x < 128 := by intro x hx; exact hv x (by simp [hx])
              have hs := splitUtf8_ascii_cons b bs hb
              have hz_full := ihp (b :: bs) hv
              have hpct := ihv hbs
              simp [ByteLikeFast, CharLike, hs, hz_full, hpct]

/-- The implemented policy: use the fast path only on an all-ASCII region,
    otherwise deoptimize to the reference matcher on the whole row. -/
def OptimizedLike (v : List Byte) (p : List Tok) : Bool :=
  if ∀ b ∈ v, b < 128 then ByteLikeFast v p else ByteLikeRef v p

theorem optimized_preserves_result (v : List Byte) (p : List Tok) :
    OptimizedLike v p = ByteLikeRef v p := by
  by_cases h : ∀ b ∈ v, b < 128
  · simp [OptimizedLike, byteRef_eq_fast v p h]
  · simp [OptimizedLike, h]

/-- **Soundness of the ASCII `_` fast path and its deoptimization.**

    On an ASCII region the generated one-byte-`_` code agrees with both the
    byte-level reference (which consumes whole UTF-8 characters) and the
    character-level reference; outside the region the fallback is
    result-preserving. -/
theorem like_underscore_sound (v : List Byte) (p : List Tok) (hv : ∀ b ∈ v, b < 128) :
    ByteLikeFast v p = ByteLikeRef v p ∧
    ByteLikeFast v p = CharLike (splitUtf8 v) p ∧
    OptimizedLike v p = ByteLikeRef v p :=
  ⟨(byteRef_eq_fast v p hv).symm, fast_eq_char v p hv, optimized_preserves_result v p⟩

/-- Escape processing shared by both paths. A final backslash is literal,
    matching EscapedLikeMatch's lookahead rule. -/
def tokenize : List Byte → List Tok
  | 92 :: c :: cs => .lit c :: tokenize cs
  | 37 :: cs => .percent :: tokenize cs
  | 95 :: cs => .under :: tokenize cs
  | c :: cs => .lit c :: tokenize cs
  | [] => []

theorem raw_like_fast_sound (row pattern : List Byte) :
    OptimizedLike row (tokenize pattern) = ByteLikeRef row (tokenize pattern) :=
  optimized_preserves_result ..

example : tokenize [92,37,92,95,92] = [.lit 37,.lit 95,.lit 92] ∧
    utf8Len 128 = 1 ∧ utf8Len 245 = 1 := by decide

end TinylambOpt.LikeUnderscore

