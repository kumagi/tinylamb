------------------------------- MODULE S3Wal -------------------------------
(***************************************************************************)
(* WAL shipping to S3 from docs/primary-s3.md.                             *)
(*                                                                         *)
(*  - A writer cuts its WAL into chunks and keeps up to Window conditional  *)
(*    PUTs (create-if-absent) in flight.  S3 may apply a request at any    *)
(*    time, even after the sender died, and responses can be lost.         *)
(*  - A writer acknowledges a record only below the end of the contiguous  *)
(*    acknowledged chunk prefix (S3 durable LSN).                          *)
(*  - Every writer incarnation owns its own epoch.  A transfer (restart or *)
(*    promotion) bumps writer.json, seals the newest epoch with a terminal *)
(*    marker created conditionally at the first free sequence number,      *)
(*    creates the next immutable epoch record, prepares the local log and  *)
(*    activates through a CAS on writer.json.                              *)
(*  - A candidate truncates (or extends) its local log to the official     *)
(*    history.  An unacknowledged local tail is never reused, so what the  *)
(*    new writer recovers and serves without a dependence is official.     *)
(*  - T1 (CAS) and T2 (pick the newest epoch) are separate steps.  A       *)
(*    candidate that finds an epoch created by a newer transfer gives up   *)
(*    before sealing.  Seals are never deleted.                            *)
(*                                                                         *)
(* Records are unique ids, so two different histories never look alike.    *)
(* The official history is what a restore reads from S3: per epoch, the    *)
(* contiguous chunk chain from sequence 1, cut at the next epoch's start.  *)
(***************************************************************************)
EXTENDS Naturals, Sequences, FiniteSets, TLC

CONSTANTS
    Hosts, InitOwner,
    MaxRecs,          \* records generated by all writers together
    MaxEpoch, Window, MaxCrashes, MaxTransfers,
    LocalFsyncHolds,  \* FALSE: a crash may lose even fsynced local bytes
    \* Each switch below removes one rule of the design (all FALSE = design).
    AckNonContiguous, \* advance the durable LSN past an unacknowledged chunk
    SameEpochRestart, \* a restart continues the old epoch's sequence space
    NoSealMarker,     \* compute the epoch end by scanning, write no marker
    Trust412,         \* treat 412 on our own chunk key as success unseen
    ReuseAnyLocal,    \* reuse the local log without the prefix check
    CkptBeyondS3,     \* publish an S3 checkpoint past the S3 durable LSN
    ChaseNewerEpoch,  \* a superseded candidate seals a newer transfer's epoch
    NoTargetCheck,    \* T2 does not compare the picked epoch's tgen (review 2)
    SealsDeletable,   \* GC may delete an old epoch's seal (review 1)
    ReuseTail         \* reuse an agreeing local tail beyond the history (review 4)

ASSUME InitOwner \in Hosts

MaxSeq  == MaxRecs + 2          \* the last slot always stays free for a seal
Seqs    == 1..MaxSeq
Epochs  == 1..MaxEpoch
None    == [kind |-> "none"]
Seal    == [kind |-> "seal"]
NoRange == [lo |-> 0, hi |-> 0]
NoEpoch == [kind |-> "none", start |-> 0, tgen |-> 0]

Min(a, b) == IF a < b THEN a ELSE b
Max(a, b) == IF a > b THEN a ELSE b
IsPrefix(s, t) == Len(s) <= Len(t) /\ SubSeq(t, 1, Len(s)) = s
Agree(s, t) == IsPrefix(s, t) \/ IsPrefix(t, s)

VARIABLES
    s3,        \* s3[e][s]: chunk object, seal marker or None
    erec,      \* immutable epoch records
    ctl,       \* control/writer.json
    net,       \* PUT requests in flight
    resp,      \* PUT responses in flight
    proc,      \* the process running on each host
    disk,      \* local WAL that survived the last crash of each host
    nextId,    \* next record id
    crashes, transfers,
    acks,      \* <<position, record>> acknowledged to clients
    ckpts,     \* contents of published S3 checkpoints
    corrupt    \* a foreign chunk or a broken chain was observed

vars == <<s3, erec, ctl, net, resp, proc, disk, nextId,
          crashes, transfers, acks, ckpts, corrupt>>

DeadProc(i) ==
    [alive |-> FALSE, inst |-> i, role |-> "none", epoch |-> 0, estart |-> 1,
     lwal |-> << >>, ldur |-> 0, cut |-> 0, next |-> 1,
     chunks |-> [s \in Seqs |-> NoRange], acked |-> {}, fenced |-> FALSE,
     phase |-> "none", target |-> 0, sseq |-> 1, expect |-> 1, tgen |-> 0,
     newep |-> 0, restored |-> 0]

-----------------------------------------------------------------------------
(* The official history (what a restore reads from S3). *)

RECURSIVE WalkFrom(_, _, _)
WalkFrom(e, s, lo) ==
    IF s > MaxSeq THEN << >>
    ELSE LET o == s3[e][s] IN
         IF o.kind = "chunk" /\ o.lo = lo
         THEN o.recs \o WalkFrom(e, s + 1, o.hi + 1)
         ELSE << >>

Exists(e) == erec[e].kind = "epoch"
Walk(e)   == WalkFrom(e, 1, erec[e].start)
MaxE      == CHOOSE m \in Epochs : Exists(m) /\ \A k \in Epochs : Exists(k) => k <= m

Part(e) ==
    IF e < MaxE
    THEN SubSeq(Walk(e), 1, Min(Len(Walk(e)), erec[e + 1].start - erec[e].start))
    ELSE Walk(e)

RECURSIVE HistFrom(_)
HistFrom(e) == IF e > MaxE THEN << >> ELSE Part(e) \o HistFrom(e + 1)
Official == HistFrom(1)

-----------------------------------------------------------------------------
(* Writer bookkeeping *)

InFlight(p) == {s \in Seqs : p.chunks[s] /= NoRange /\ s \notin p.acked}

RECURSIVE FirstUnacked(_, _)
FirstUnacked(p, s) ==
    IF s <= MaxSeq /\ p.chunks[s] /= NoRange /\ s \in p.acked
    THEN FirstUnacked(p, s + 1) ELSE s

ContigDur(p) ==
    LET s == FirstUnacked(p, 1) IN
    IF s = 1 THEN p.estart - 1 ELSE p.chunks[s - 1].hi

AnyAckedHi(p) ==
    LET S == {p.chunks[s].hi : s \in p.acked} IN
    IF S = {} THEN p.estart - 1 ELSE CHOOSE m \in S : \A x \in S : x <= m

Durable(p) == IF AckNonContiguous THEN Max(ContigDur(p), AnyAckedHi(p))
              ELSE ContigDur(p)

MyObj(p, s) ==
    [kind |-> "chunk", lo |-> p.chunks[s].lo, hi |-> p.chunks[s].hi,
     recs |-> SubSeq(p.lwal, p.chunks[s].lo, p.chunks[s].hi)]

IsWriter(h) == proc[h].alive /\ proc[h].role = "writer" /\ ~proc[h].fenced

-----------------------------------------------------------------------------
Init ==
    /\ s3 = [e \in Epochs |-> [s \in Seqs |-> None]]
    /\ erec = [e \in Epochs |-> IF e = 1
                                THEN [kind |-> "epoch", start |-> 1, tgen |-> 0]
                                ELSE NoEpoch]
    /\ ctl = [gen |-> 1, state |-> "active", epoch |-> 1,
              owner |-> InitOwner, cand |-> InitOwner]
    /\ net = {}
    /\ resp = {}
    /\ proc = [h \in Hosts |->
                 IF h = InitOwner
                 THEN [DeadProc(1) EXCEPT !.alive = TRUE, !.role = "writer",
                                          !.epoch = 1]
                 ELSE DeadProc(0)]
    /\ disk = [h \in Hosts |-> << >>]
    /\ nextId = 1
    /\ crashes = 0
    /\ transfers = 0
    /\ acks = {}
    /\ ckpts = {}
    /\ corrupt = FALSE

(* A transaction appends one commit record to the local log. *)
AppendRec(h) ==
    /\ IsWriter(h)
    /\ nextId <= MaxRecs
    /\ proc' = [proc EXCEPT ![h].lwal = Append(@, nextId)]
    /\ nextId' = nextId + 1
    /\ UNCHANGED <<s3, erec, ctl, net, resp, disk, crashes, transfers, acks,
                   ckpts, corrupt>>

(* Local fdatasync. *)
Sync(h) ==
    /\ proc[h].alive
    /\ proc[h].ldur < Len(proc[h].lwal)
    /\ proc' = [proc EXCEPT ![h].ldur = Len(proc[h].lwal)]
    /\ UNCHANGED <<s3, erec, ctl, net, resp, disk, nextId, crashes, transfers,
                   acks, ckpts, corrupt>>

(* Cut the next chunk [cut+1, hi] and send its conditional PUT. *)
Cut(h, hi) ==
    LET p == proc[h] IN
    /\ IsWriter(h)
    /\ p.cut < Len(p.lwal)
    /\ hi \in (p.cut + 1)..Len(p.lwal)
    /\ Cardinality(InFlight(p)) < Window
    /\ p.next < MaxSeq
    /\ LET r == [lo |-> p.cut + 1, hi |-> hi]
           o == [kind |-> "chunk", lo |-> p.cut + 1, hi |-> hi,
                 recs |-> SubSeq(p.lwal, p.cut + 1, hi)]
       IN /\ proc' = [proc EXCEPT ![h].chunks[p.next] = r,
                                  ![h].next = p.next + 1, ![h].cut = hi]
          /\ net' = net \cup {[e |-> p.epoch, s |-> p.next, obj |-> o,
                               h |-> h, inst |-> p.inst]}
    /\ UNCHANGED <<s3, erec, ctl, resp, disk, nextId, crashes, transfers, acks,
                   ckpts, corrupt>>

(* Retry or hedge a PUT whose outcome is unknown: same key, same body. *)
Resend(h, s) ==
    LET p == proc[h] IN
    /\ IsWriter(h)
    /\ s \in InFlight(p)
    /\ ~\E r \in net : r.h = h /\ r.inst = p.inst /\ r.e = p.epoch /\ r.s = s
    /\ ~\E r \in resp : r.h = h /\ r.inst = p.inst /\ r.e = p.epoch /\ r.s = s
    /\ net' = net \cup {[e |-> p.epoch, s |-> s, obj |-> MyObj(p, s),
                         h |-> h, inst |-> p.inst]}
    /\ UNCHANGED <<s3, erec, ctl, resp, proc, disk, nextId, crashes, transfers,
                   acks, ckpts, corrupt>>

(* S3 applies a PUT (create only if absent).  A response to a dead       *)
(* incarnation is never delivered, so it is not generated.               *)
Land(r) ==
    /\ r \in net
    /\ LET code == IF s3[r.e][r.s].kind = "none" THEN 200 ELSE 412 IN
       /\ s3' = IF code = 200 THEN [s3 EXCEPT ![r.e][r.s] = r.obj] ELSE s3
       /\ resp' = IF proc[r.h].alive /\ proc[r.h].inst = r.inst
                  THEN resp \cup {[e |-> r.e, s |-> r.s, code |-> code,
                                   h |-> r.h, inst |-> r.inst]}
                  ELSE resp
    /\ net' = net \ {r}
    /\ UNCHANGED <<erec, ctl, proc, disk, nextId, crashes, transfers, acks,
                   ckpts, corrupt>>

DropResp(r) ==
    /\ r \in resp
    /\ resp' = resp \ {r}
    /\ UNCHANGED <<s3, erec, ctl, net, proc, disk, nextId, crashes, transfers,
                   acks, ckpts, corrupt>>

(* 200: the chunk is stored.  412: HEAD the key and compare the checksum; *)
(* our own earlier attempt counts, a seal fences us, anything else is a   *)
(* second writer in our epoch.                                            *)
Receive(r) ==
    LET h == r.h
        p == proc[h]
        o == s3[r.e][r.s]
    IN
    /\ r \in resp
    /\ p.alive /\ p.inst = r.inst /\ p.role = "writer"
    /\ resp' = resp \ {r}
    /\ IF r.code = 200 \/ Trust412 \/ o = MyObj(p, r.s)
       THEN /\ proc' = [proc EXCEPT ![h].acked = @ \cup {r.s}]
            /\ UNCHANGED corrupt
       ELSE /\ proc' = [proc EXCEPT ![h].fenced = TRUE]
            /\ corrupt' = (o.kind /= "seal" \/ corrupt)
    /\ UNCHANGED <<s3, erec, ctl, net, disk, nextId, crashes, transfers, acks,
                   ckpts>>

(* Reply COMMIT success for a record below the durable LSN. *)
Ack(h, i) ==
    LET p == proc[h] IN
    /\ p.alive /\ p.role = "writer"
    /\ i >= p.estart
    /\ i <= Durable(p)
    /\ i <= Len(p.lwal)
    /\ <<i, p.lwal[i]>> \notin acks
    /\ acks' = acks \cup {<<i, p.lwal[i]>>}
    /\ UNCHANGED <<s3, erec, ctl, net, resp, proc, disk, nextId, crashes,
                   transfers, ckpts, corrupt>>

(* Publish an S3 checkpoint covering the local state up to c. *)
PublishCkpt(h) ==
    LET p == proc[h]
        c == IF CkptBeyondS3 THEN Len(p.lwal) ELSE Durable(p)
    IN
    /\ p.alive /\ p.role = "writer"
    /\ c >= 1
    /\ SubSeq(p.lwal, 1, c) \notin ckpts
    /\ ckpts' = ckpts \cup {SubSeq(p.lwal, 1, c)}
    /\ UNCHANGED <<s3, erec, ctl, net, resp, proc, disk, nextId, crashes,
                   transfers, acks, corrupt>>

(* The process dies.  Its requests stay in the network.  The local log   *)
(* keeps a prefix: at least the fsynced part if LocalFsyncHolds.         *)
Crash(h) ==
    LET p == proc[h] IN
    /\ p.alive
    /\ crashes < MaxCrashes
    /\ \E k \in (IF LocalFsyncHolds THEN p.ldur ELSE 0)..Len(p.lwal) :
           disk' = [disk EXCEPT ![h] = SubSeq(p.lwal, 1, k)]
    /\ proc' = [proc EXCEPT ![h] = DeadProc(p.inst)]
    /\ resp' = {r \in resp : r.h /= h}
    /\ crashes' = crashes + 1
    /\ UNCHANGED <<s3, erec, ctl, net, nextId, transfers, acks, ckpts, corrupt>>

(* The host's disk is replaced. *)
DiskLoss(h) ==
    /\ ~proc[h].alive
    /\ disk[h] /= << >>
    /\ crashes < MaxCrashes
    /\ disk' = [disk EXCEPT ![h] = << >>]
    /\ crashes' = crashes + 1
    /\ UNCHANGED <<s3, erec, ctl, net, resp, proc, nextId, transfers, acks,
                   ckpts, corrupt>>

-----------------------------------------------------------------------------
(* Transfer: restart on the same host or promotion of another host.  The *)
(* operator kills the old process first only when it runs on host c.     *)

BeginTransfer(c) ==
    /\ transfers < MaxTransfers
    /\ ~proc[c].alive
    /\ ctl' = [ctl EXCEPT !.gen = @ + 1, !.state = "transfer", !.cand = c]
    /\ proc' = [proc EXCEPT ![c] =
                  [DeadProc(proc[c].inst + 1) EXCEPT
                      !.alive = TRUE, !.role = "cand", !.phase = "pick",
                      !.lwal = disk[c], !.ldur = Len(disk[c]),
                      !.tgen = ctl.gen + 1]]
    /\ transfers' = transfers + 1
    /\ UNCHANGED <<s3, erec, net, resp, disk, nextId, crashes, acks, ckpts,
                   corrupt>>

(* T2, a separate step after the CAS: pick the newest epoch.  If a newer *)
(* transfer created it, we were overtaken: give up before sealing.        *)
PickTarget(c) ==
    LET p == proc[c] IN
    /\ p.alive /\ p.role = "cand" /\ p.phase = "pick"
    /\ proc' = IF ~NoTargetCheck /\ erec[MaxE].tgen > p.tgen
               THEN [proc EXCEPT ![c] = DeadProc(p.inst)]
               ELSE [proc EXCEPT ![c].phase = "scan", ![c].target = MaxE,
                                 ![c].sseq = 1, ![c].expect = erec[MaxE].start]
    /\ UNCHANGED <<s3, erec, ctl, net, resp, disk, nextId, crashes, transfers,
                   acks, ckpts, corrupt>>

(* Bug only: GC deletes the seal of an old epoch. *)
DeleteSeal(e, s) ==
    /\ SealsDeletable
    /\ e < MaxE
    /\ s3[e][s].kind = "seal"
    /\ s3' = [s3 EXCEPT ![e][s] = None]
    /\ UNCHANGED <<erec, ctl, net, resp, proc, disk, nextId, crashes, transfers,
                   acks, ckpts, corrupt>>

(* Walk the target epoch; at the first free sequence number create the   *)
(* terminal marker (conditional create, so it races with late chunks).   *)
ScanStep(c) ==
    LET p == proc[c]
        o == s3[p.target][p.sseq]
    IN
    /\ p.alive /\ p.role = "cand" /\ p.phase = "scan"
    /\ CASE o.kind = "chunk" /\ o.lo = p.expect ->
              /\ proc' = [proc EXCEPT ![c].sseq = p.sseq + 1,
                                      ![c].expect = o.hi + 1]
              /\ UNCHANGED <<s3, corrupt>>
         [] o.kind = "chunk" ->
              /\ proc' = [proc EXCEPT ![c].phase = "stuck"]
              /\ corrupt' = TRUE
              /\ UNCHANGED s3
         [] o.kind = "seal" ->
              /\ proc' = [proc EXCEPT ![c].phase = "create"]
              /\ UNCHANGED <<s3, corrupt>>
         [] OTHER ->
              IF SameEpochRestart
              THEN /\ proc' = [proc EXCEPT ![c].phase = "prepare"]
                   /\ UNCHANGED <<s3, corrupt>>
              ELSE /\ s3' = IF NoSealMarker THEN s3
                            ELSE [s3 EXCEPT ![p.target][p.sseq] = Seal]
                   /\ proc' = [proc EXCEPT ![c].phase = "create"]
                   /\ UNCHANGED corrupt
    /\ UNCHANGED <<erec, ctl, net, resp, disk, nextId, crashes, transfers, acks,
                   ckpts>>

(* Create the next epoch record.  If it exists, an older (superseded)    *)
(* transfer's epoch is sealed in turn; a newer transfer's makes us quit. *)
CreateEpoch(c) ==
    LET p == proc[c]
        n == p.target + 1
    IN
    /\ p.alive /\ p.role = "cand" /\ p.phase = "create"
    /\ n <= MaxEpoch
    /\ IF erec[n].kind = "none"
       THEN /\ erec' = [erec EXCEPT ![n] = [kind |-> "epoch", start |-> p.expect,
                                            tgen |-> p.tgen]]
            /\ proc' = [proc EXCEPT ![c].phase = "prepare", ![c].newep = n]
       ELSE /\ erec' = erec
            /\ proc' = IF ChaseNewerEpoch \/ erec[n].tgen < p.tgen
                       THEN [proc EXCEPT ![c].target = n, ![c].sseq = 1,
                                         ![c].expect = erec[n].start,
                                         ![c].phase = "scan"]
                       ELSE [proc EXCEPT ![c] = DeadProc(p.inst)]
    /\ UNCHANGED <<s3, ctl, net, resp, disk, nextId, crashes, transfers, acks,
                   ckpts, corrupt>>

(* Build the local log: reuse the surviving local log only if it agrees  *)
(* with the official history, otherwise restore from S3.                 *)
Prepare(c) ==
    LET p == proc[c]
        H == SubSeq(Official, 1, Min(Len(Official), p.expect - 1))
        D == p.lwal
        \* Design: truncate or extend the local log to H.
        w == IF ReuseAnyLocal
             THEN (IF Len(D) >= Len(H) THEN D ELSE D \o SubSeq(H, Len(D) + 1, Len(H)))
             ELSE IF ReuseTail /\ Agree(D, H) /\ Len(D) > Len(H) THEN D
             ELSE H
    IN
    /\ p.alive /\ p.role = "cand" /\ p.phase = "prepare"
    /\ proc' = [proc EXCEPT ![c].lwal = w, ![c].ldur = Len(w),
                            ![c].phase = "activate"]
    /\ UNCHANGED <<s3, erec, ctl, net, resp, disk, nextId, crashes, transfers,
                   acks, ckpts, corrupt>>

(* CAS writer.json from our transfer to active.  A bug variant keeps the *)
(* old epoch and adopts its landed chunks as acknowledged.               *)
Activate(c) ==
    LET p == proc[c]
        ep == IF SameEpochRestart THEN p.target ELSE p.newep
        sameChunks == [s \in Seqs |->
                         IF s < p.sseq
                         THEN [lo |-> s3[p.target][s].lo, hi |-> s3[p.target][s].hi]
                         ELSE NoRange]
    IN
    /\ p.alive /\ p.role = "cand" /\ p.phase = "activate"
    /\ IF ctl.gen = p.tgen /\ ctl.state = "transfer" /\ ctl.cand = c
       THEN /\ ctl' = [gen |-> ctl.gen + 1, state |-> "active", epoch |-> ep,
                       owner |-> c, cand |-> c]
            /\ proc' = [proc EXCEPT
                   ![c].role = "writer", ![c].epoch = ep,
                   ![c].restored = Len(p.lwal),
                   ![c].estart = IF SameEpochRestart THEN erec[ep].start ELSE p.expect,
                   ![c].cut = p.expect - 1,
                   ![c].next = IF SameEpochRestart THEN p.sseq ELSE 1,
                   ![c].chunks = IF SameEpochRestart THEN sameChunks
                                 ELSE [s \in Seqs |-> NoRange],
                   ![c].acked = IF SameEpochRestart THEN 1..(p.sseq - 1) ELSE {},
                   ![c].phase = "none"]
       ELSE /\ ctl' = ctl
            /\ proc' = [proc EXCEPT ![c] = DeadProc(p.inst)]
    /\ UNCHANGED <<s3, erec, net, resp, disk, nextId, crashes, transfers, acks,
                   ckpts, corrupt>>

-----------------------------------------------------------------------------
Next ==
    \/ \E h \in Hosts :
         \/ AppendRec(h) \/ Sync(h) \/ Crash(h) \/ DiskLoss(h)
         \/ BeginTransfer(h) \/ PickTarget(h) \/ ScanStep(h) \/ CreateEpoch(h)
         \/ Prepare(h) \/ Activate(h) \/ PublishCkpt(h)
         \/ \E hi \in 1..MaxRecs : Cut(h, hi)
         \/ \E s \in Seqs : Resend(h, s)
         \/ \E i \in 1..MaxRecs : Ack(h, i)
    \/ \E e \in Epochs, s \in Seqs : DeleteSeal(e, s)
    \/ \E r \in net : Land(r)
    \/ \E r \in resp : Receive(r) \/ DropResp(r)

Spec == Init /\ [][Next]_vars

-----------------------------------------------------------------------------
(* Safety *)

\* Every COMMIT success refers to a record of the official history.
NoLostAck == \A a \in acks : a[1] <= Len(Official) /\ Official[a[1]] = a[2]

\* What a live writer believes durable is official.
DurableIsOfficial ==
    \A h \in Hosts :
        (proc[h].alive /\ proc[h].role = "writer") =>
            IsPrefix(SubSeq(proc[h].lwal, 1,
                            Min(Durable(proc[h]), Len(proc[h].lwal))), Official)

\* What a writer recovered at activation, and serves through physical reads
\* without a durability dependence, is official.
RestoredIsOfficial ==
    \A h \in Hosts :
        (proc[h].alive /\ proc[h].role = "writer") =>
            IsPrefix(SubSeq(proc[h].lwal, 1, proc[h].restored), Official)

\* The writer named by writer.json extends the official history.
ActiveWriterAgrees ==
    LET o == ctl.owner IN
    (ctl.state = "active" /\ proc[o].alive /\ proc[o].role = "writer"
     /\ proc[o].epoch = ctl.epoch) => Agree(proc[o].lwal, Official)

\* Consecutive epochs leave no gap.
EpochsAbut ==
    \A e \in Epochs : e < MaxE => erec[e + 1].start = erec[e].start + Len(Part(e))

\* Every published checkpoint is a prefix of the official history.
CkptConsistent == \A ck \in ckpts : IsPrefix(ck, Official)

\* Nobody met a foreign chunk in its own epoch or a broken chain.
NoConflict == ~corrupt

\* The epoch writer.json calls active is never sealed.
ActiveEpochUnsealed ==
    ctl.state = "active" => \A s \in Seqs : s3[ctl.epoch][s].kind /= "seal"

\* The official history only grows.
HistoryMonotone == [][IsPrefix(Official, Official')]_vars
=============================================================================
