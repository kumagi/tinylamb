Checks: '-*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-suspicious-missing-comma,
  -bugprone-reserved-identifier,
  concurrency-*,
  cppcoreguidelines-no-malloc,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-explicit-virtual-functions,
  cppcoreguidelines-virtual-class-destructor,
  cppcoreguidelines-slicing,
  cppcoreguidelines-pro-type-cstyle-cast,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-static-cast-downcast,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-c-copy-assignment-signature,
  cppcoreguidelines-special-member-functions,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  -misc-const-correctness,
  -misc-include-cleaner,
  -misc-no-recursion,
  cert-*,
  modernize-*,
  -modernize-use-using,
  -modernize-macro-to-enum,
  -modernize-use-trailing-return-type,
  -modernize-use-ranges,
  performance-*,
  -performance-enum-size,
  readability-*,
  -readability-avoid-nested-conditional-operator,
  -readability-function-cognitive-complexity,
  -readability-function-size,
  -readability-identifier-length,
  -readability-isolate-declaration,
  -readability-magic-numbers,
  -readability-redundant-member-init,
'
CheckOptions:
  # Keep the LLVM defaults and also diagnose discarded storage/query results.
  bugprone-unused-return-value.CheckedReturnTypes: '^::std::error_code$;^::std::error_condition$;^::std::errc$;^::std::expected(<|$);^::boost::system::error_code$;^::tinylamb::Status$;^::tinylamb::StatusOr<.*>$'
