]
==

[mode=explain]
[plan_contains=HashJoin]
[name=dimension_uniqueness_prevents_cardinality_explosion]
SELECT f.sale_id, c.tier, p.category
FROM opt_fact_sales f
JOIN opt_dim_customer c ON f.customer_id = c.customer_id
JOIN opt_dim_product p ON f.product_id = p.product_id
ORDER BY f.sale_id
--
ARRAY<STRUCT<sale_id INT64, tier STRING, category STRING>>[
  {1001, "gold", "book"}, {1002, "gold", "food"},
  {1003, "silver", "book"}, {1004, "gold", "book"},
  {1005, "bronze", "food"}, {1006, "gold", "book"}
]
==

# Future: CommonDimensionScan opt_dim_customer uses=2
[mode=explain]
[plan_contains=CteInline]
[name=self_contained_star_branches_share_dimension_scan]
WITH gold AS (
  SELECT f.sale_id, f.revenue
  FROM opt_fact_sales f JOIN opt_dim_customer c
  ON f.customer_id = c.customer_id WHERE c.tier = 'gold'
)
SELECT COUNT(*) AS n, SUM(revenue) AS total FROM gold
--
ARRAY<STRUCT<n INT64, total INT64>>[{4, 390}]
==

# Future: AggregatePushdown through UnionAll
[mode=explain]
[plan_contains=SubqueryScan]
[name=partitionwise_aggregate_combines_partial_results]
SELECT customer_id, SUM(revenue) AS total
FROM (
  SELECT customer_id, revenue FROM opt_fact_sales WHERE date_id <= 2
  UNION ALL
  SELECT customer_id, revenue FROM opt_fact_sales WHERE date_id = 3
) f
GROUP BY customer_id ORDER BY customer_id
--
ARRAY<STRUCT<customer_id INT64, total INT64>>[
  {1, 150}, {2, 70}, {3, 240}, {4, 20}
]
==

[mode=explain]
[plan_contains=EmptyResult]
[plan_not_contains=opt_fact_sales]
[name=contradictory_dimension_predicate_eliminates_fact_scan]
SELECT f.sale_id
FROM opt_fact_sales f JOIN opt_dim_date d ON f.date_id = d.date_id
WHERE d.year = 2025 AND d.year = 2026
--
ARRAY<STRUCT<sale_id INT64>>[]
==

[mode=explain]
[plan_contains=HashJoin]
[name=small_dimension_uses_exact_runtime_key_set]
SELECT f.sale_id
FROM opt_fact_sales f JOIN opt_dim_product p
ON f.product_id = p.product_id
WHERE p.category = 'book'
ORDER BY f.sale_id
