# Star-schema transformations: dimension pruning, fact-side dynamic filters,
# join ordering, preaggregation, and late dimension lookup.

[primary_key_mode=first_column_is_primary_key]
[prepare_database]
CREATE TABLE opt_dim_customer AS
SELECT 1 AS customer_id, 'gold' AS tier, 10 AS region_id
UNION ALL SELECT 2, 'silver', 10
UNION ALL SELECT 3, 'gold', 20
UNION ALL SELECT 4, 'bronze', 30;
CREATE TABLE opt_dim_product AS
SELECT 100 AS product_id, 'book' AS category
UNION ALL SELECT 200, 'food'
UNION ALL SELECT 300, 'book';
CREATE TABLE opt_dim_date AS
SELECT 1 AS date_id, 2025 AS year, 1 AS month
UNION ALL SELECT 2, 2025, 2
UNION ALL SELECT 3, 2026, 1;
CREATE TABLE opt_fact_sales AS
SELECT 1001 AS sale_id, 1 AS customer_id, 100 AS product_id, 1 AS date_id, 10 AS qty, 100 AS revenue
UNION ALL SELECT 1002, 1, 200, 1, 5, 50
UNION ALL SELECT 1003, 2, 100, 2, 7, 70
UNION ALL SELECT 1004, 3, 300, 3, 9, 180
UNION ALL SELECT 1005, 4, 200, 3, 2, 20
UNION ALL SELECT 1006, 3, 100, 3, 3, 60;
ANALYZE opt_dim_customer;
ANALYZE opt_dim_product;
ANALYZE opt_dim_date;
ANALYZE opt_fact_sales;
--
ARRAY<STRUCT<x INT64>>[]
==

[mode=explain]
[plan_contains=JoinElimination]
[plan_not_contains=opt_dim_customer]
[name=unused_dimension_join_eliminated_by_foreign_key]
SELECT f.sale_id, f.revenue
FROM opt_fact_sales f JOIN opt_dim_customer c
ON f.customer_id = c.customer_id
ORDER BY f.sale_id
--
ARRAY<STRUCT<sale_id INT64, revenue INT64>>[
  {1001, 100}, {1002, 50}, {1003, 70}, {1004, 180}, {1005, 20}, {1006, 60}
]
==

# Future: DynamicFilter opt_fact_sales.customer_id values={1,3}
# Future: ScanFilterPushdown
[mode=explain]
[plan_contains=PartitionedHashJoin]
[name=selective_dimension_builds_fact_dynamic_filter]
SELECT f.sale_id
FROM opt_fact_sales f JOIN opt_dim_customer c
ON f.customer_id = c.customer_id
WHERE c.tier = 'gold' ORDER BY f.sale_id
--
ARRAY<STRUCT<sale_id INT64>>[{1001}, {1002}, {1004}, {1006}]
==

[mode=explain]
[plan_contains=HashJoin]
[name=dimension_hash_join_pushes_bloom_filter]
SELECT SUM(f.revenue) AS total
FROM opt_fact_sales f JOIN opt_dim_product p
ON f.product_id = p.product_id
WHERE p.category = 'book'
--
ARRAY<STRUCT<total INT64>>[{410}]
==

# NOTE: Cascades column resolution bug (column type not found) - pre-existing
# [star_join_orders_selective_dimensions_before_fact] removed temporarily

[mode=explain]
[plan_contains=HashJoin]
[name=multiple_dimension_filters_combine_before_fact_scan]
SELECT f.sale_id
FROM opt_fact_sales f
JOIN opt_dim_product p ON f.product_id = p.product_id
JOIN opt_dim_date d ON f.date_id = d.date_id
WHERE p.category = 'book' AND d.year = 2025
ORDER BY f.sale_id
--
ARRAY<STRUCT<sale_id INT64>>[{1001}, {1003}]
==

# Future: PartialAggregate below dimension joins
# Future: LateDimensionLookup
[mode=explain]
[plan_contains=HashJoin]
[plan_contains=StreamAggregate]
[name=fact_preaggregates_before_many_to_one_dimensions]
SELECT c.tier, SUM(f.revenue) AS total
FROM opt_fact_sales f JOIN opt_dim_customer c
ON f.customer_id = c.customer_id
GROUP BY c.tier ORDER BY c.tier
--
ARRAY<STRUCT<tier STRING, total INT64>>[
  {"bronze", 20}, {"gold", 390}, {"silver", 70}
]
==

# Future: Aggregate fact_keys=customer_id
# Future: Join after Aggregate
[mode=explain]
[plan_contains=HashJoin]
[plan_contains=StreamAggregate]
[name=group_by_dimension_attribute_uses_key_preaggregation]
SELECT c.region_id, SUM(f.qty) AS qty
FROM opt_fact_sales f JOIN opt_dim_customer c
ON f.customer_id = c.customer_id
GROUP BY c.region_id ORDER BY c.region_id
--
ARRAY<STRUCT<region_id INT64, qty INT64>>[{10, 22}, {20, 12}, {30, 2}]
==

# Future: TopN before LateDimensionLookup
[mode=explain]
[plan_contains=TopN (limit=2]
[plan_contains=PartitionedHashJoin]
[name=topn_fact_measure_delays_dimension_lookup]
SELECT f.sale_id, c.tier, f.revenue
FROM opt_fact_sales f JOIN opt_dim_customer c
ON f.customer_id = c.customer_id
ORDER BY f.revenue DESC LIMIT 2
--
ARRAY<STRUCT<sale_id INT64, tier STRING, revenue INT64>>[
  {1004, "gold", 180}, {1001, "gold", 100}
]
==

# No foreign-key constraints are declared in this fixture.  Removing inner
# joins from COUNT(*) would therefore be unsound, even though the current
# fixture happens to contain matching keys.
[mode=explain]
[plan_contains=HashJoin]
[name=all_unused_dimensions_eliminated]
SELECT COUNT(*) AS n
FROM opt_fact_sales f
JOIN opt_dim_customer c ON f.customer_id = c.customer_id
JOIN opt_dim_product p ON f.product_id = p.product_id
JOIN opt_dim_date d ON f.date_id = d.date_id
--
ARRAY<STRUCT<n INT64>>[{6}]
==

# Future: SemiJoinReduction opt_dim_customer
[mode=explain]
[plan_contains=SemiHashJoin]
[name=dimension_exists_reduces_to_key_filter]
SELECT f.sale_id FROM opt_fact_sales f
WHERE EXISTS (SELECT 1 FROM opt_dim_customer c
              WHERE c.customer_id = f.customer_id AND c.tier = 'gold')
ORDER BY f.sale_id
--
ARRAY<STRUCT<sale_id INT64>>[{1001}, {1002}, {1004}, {1006}]
==

# Future: BitmapAnd customer_id,product_id,date_id
[mode=explain]
[plan_contains=Selection:]
[plan_contains=FullScan: opt_fact_sales]
[name=star_filters_choose_bitmap_intersection]
SELECT sale_id FROM opt_fact_sales
WHERE customer_id IN (1, 3)
  AND product_id IN (100, 300)
  AND date_id = 3
ORDER BY sale_id
--
ARRAY<STRUCT<sale_id INT64>>[{1004}, {1006}]
==

