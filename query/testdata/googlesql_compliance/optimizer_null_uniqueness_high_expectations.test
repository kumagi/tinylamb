# NULL semantics, uniqueness proofs, and functional-dependency expectations.

[prepare_database]
CREATE TABLE opt_nullable AS
SELECT 1 AS id, 10 AS x, 10 AS y, 'a' AS tag, true AS enabled
UNION ALL SELECT 2, 10, CAST(NULL AS INT64), 'a', false
UNION ALL SELECT 3, CAST(NULL AS INT64), 10, CAST(NULL AS STRING), true
UNION ALL SELECT 4, CAST(NULL AS INT64), CAST(NULL AS INT64), 'b', CAST(NULL AS BOOL)
UNION ALL SELECT 5, 20, 20, 'b', false;
CREATE TABLE opt_unique_parent AS
SELECT 10 AS parent_id, 'ten' AS label
UNION ALL SELECT 20, 'twenty'
UNION ALL SELECT 30, 'thirty';
CREATE TABLE opt_unique_child AS
SELECT 101 AS child_id, 10 AS parent_id, 5 AS value
UNION ALL SELECT 102, 10, 7
UNION ALL SELECT 103, 20, 11;
ANALYZE opt_nullable;
ANALYZE opt_unique_parent;
ANALYZE opt_unique_child;
--
ARRAY<STRUCT<x INT64>>[]
==

[mode=explain]
[plan_not_contains=IS DISTINCT FROM]
[plan_contains=NullSafeNotEqual]
[name=is_distinct_from_lowers_to_null_safe_primitive]
SELECT id FROM opt_nullable WHERE x IS DISTINCT FROM y ORDER BY id
--
ARRAY<STRUCT<id INT64>>[{2}, {3}]
==

[mode=explain]
[plan_not_contains=IS NOT DISTINCT FROM]
[plan_contains=NullSafeEqual]
[name=is_not_distinct_from_lowers_to_null_safe_primitive]
SELECT id FROM opt_nullable WHERE x IS NOT DISTINCT FROM y ORDER BY id
--
ARRAY<STRUCT<id INT64>>[{1}, {4}, {5}]
==

[mode=explain]
[plan_contains=HashJoin null_safe=true]
[plan_not_contains=NestedLoopJoin]
[name=null_safe_equality_is_hash_joinable]
SELECT l.id AS left_id, r.id AS right_id
FROM opt_nullable l JOIN opt_nullable r
ON l.x IS NOT DISTINCT FROM r.y
WHERE l.id IN (2, 4) AND r.id IN (1, 4)
ORDER BY left_id, right_id
--
ARRAY<STRUCT<left_id INT64, right_id INT64>>[{2, 1}, {4, 4}]
==

[mode=explain]
[plan_contains=EmptyResult]
[plan_not_contains=opt_nullable]
[name=not_in_constant_null_is_never_true]
SELECT id FROM opt_nullable WHERE x NOT IN (10, NULL)
--
ARRAY<STRUCT<id INT64>>[]
==

[mode=explain]
[plan_contains=NullAwareAntiHashJoin]
[name=not_in_nullable_subquery_preserves_poison_null]
SELECT p.parent_id FROM opt_unique_parent p
WHERE p.parent_id NOT IN (SELECT x FROM opt_nullable)
ORDER BY p.parent_id
--
ARRAY<STRUCT<parent_id INT64>>[]
==

[mode=explain]
[plan_contains=AntiHashJoin null_aware=false]
[plan_not_contains=NullAwareAntiHashJoin]
[name=not_in_non_null_filtered_subquery_uses_plain_anti_join]
SELECT p.parent_id FROM opt_unique_parent p
WHERE p.parent_id NOT IN (SELECT x FROM opt_nullable WHERE x IS NOT NULL)
ORDER BY p.parent_id
--
ARRAY<STRUCT<parent_id INT64>>[{30}]
==

[mode=explain]
[plan_contains=AntiHashJoin]
[plan_not_contains=NullAwareAntiHashJoin]
[name=not_exists_does_not_need_null_aware_join]
SELECT p.parent_id FROM opt_unique_parent p
WHERE NOT EXISTS (SELECT 1 FROM opt_nullable n WHERE n.x = p.parent_id)
ORDER BY p.parent_id
--
ARRAY<STRUCT<parent_id INT64>>[{30}]
==

[mode=explain]
[plan_not_contains=COALESCE]
[plan_contains=IS NULL]
[name=coalesce_boolean_predicate_respects_unknown]
SELECT id FROM opt_nullable WHERE COALESCE(enabled, false) ORDER BY id
--
ARRAY<STRUCT<id INT64>>[{1}, {3}]
==

[mode=explain]
[plan_not_contains=NOT]
[plan_contains=enabled = false]
[name=is_false_canonicalizes_without_losing_nulls]
SELECT id FROM opt_nullable WHERE enabled IS FALSE ORDER BY id
--
ARRAY<STRUCT<id INT64>>[{2}, {5}]
==

[mode=explain]
[plan_contains=EmptyResult]
[name=nullable_equality_and_null_test_contradiction]
SELECT id FROM opt_nullable WHERE x = 10 AND x IS NULL
--
ARRAY<STRUCT<id INT64>>[]
==

[mode=explain]
[plan_not_contains=Distinct]
[name=distinct_primary_key_removed_by_uniqueness_proof]
SELECT DISTINCT parent_id FROM opt_unique_parent ORDER BY parent_id
--
ARRAY<STRUCT<parent_id INT64>>[{10}, {20}, {30}]
==

[mode=explain]
[plan_not_contains=Aggregate]
[name=group_by_primary_key_reduced_to_projection]
SELECT parent_id, MAX(label) AS label
FROM opt_unique_parent GROUP BY parent_id ORDER BY parent_id
--
ARRAY<STRUCT<parent_id INT64, label STRING>>[
  {10, "ten"}, {20, "twenty"}, {30, "thirty"}
]
==

[mode=explain]
[plan_not_contains=opt_unique_parent]
[plan_not_contains=Join]
[name=foreign_key_join_eliminated_when_parent_columns_unused]
SELECT c.child_id, c.value
FROM opt_unique_child c JOIN opt_unique_parent p
ON c.parent_id = p.parent_id
ORDER BY c.child_id
--
ARRAY<STRUCT<child_id INT64, value INT64>>[{101, 5}, {102, 7}, {103, 11}]
==

[mode=explain]
[plan_not_contains=Join]
[plan_not_contains=opt_unique_child]
[name=unused_unique_side_left_join_eliminated]
SELECT p.parent_id
FROM opt_unique_parent p LEFT JOIN opt_unique_child c
ON p.parent_id = c.child_id
ORDER BY p.parent_id
--
ARRAY<STRUCT<parent_id INT64>>[{10}, {20}, {30}]
==

[mode=explain]
[plan_contains=JoinCardinality many_to_one]
[plan_contains=rows~3]
[name=unique_build_key_tightens_join_cardinality]
SELECT c.child_id, p.label
FROM opt_unique_child c JOIN opt_unique_parent p
ON c.parent_id = p.parent_id
ORDER BY c.child_id
--
ARRAY<STRUCT<child_id INT64, label STRING>>[
  {101, "ten"}, {102, "ten"}, {103, "twenty"}
]
==

[mode=explain]
[plan_contains=Aggregate group_keys=parent_id]
[plan_not_contains=group_keys=parent_id,label]
[name=functional_dependency_prunes_redundant_group_key]
SELECT parent_id, label, COUNT(*) AS n
FROM opt_unique_parent GROUP BY parent_id, label ORDER BY parent_id
--
ARRAY<STRUCT<parent_id INT64, label STRING, n INT64>>[
  {10, "ten", 1}, {20, "twenty", 1}, {30, "thirty", 1}
]
==

[mode=explain]
[plan_not_contains=Sort]
[plan_contains=IndexOnlyScan: opt_unique_parent]
[name=unique_order_key_makes_trailing_sort_keys_redundant]
SELECT parent_id, label FROM opt_unique_parent ORDER BY parent_id, label
--
ARRAY<STRUCT<parent_id INT64, label STRING>>[
  {10, "ten"}, {20, "twenty"}, {30, "thirty"}
]
==

[mode=explain]
[plan_contains=EmptyResult]
[plan_not_contains=Join]
[name=uniqueness_plus_conflicting_constants_eliminates_join]
SELECT c.child_id FROM opt_unique_child c JOIN opt_unique_parent p
ON c.parent_id = p.parent_id
WHERE c.parent_id = 10 AND p.parent_id = 20
--
ARRAY<STRUCT<child_id INT64>>[]
==
