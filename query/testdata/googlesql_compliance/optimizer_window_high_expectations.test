# Window planning expectations: sort sharing, Top-N conversion, frame
# specialization, and predicate placement.

[primary_key_mode=first_column_is_primary_key]
[prepare_database]
CREATE TABLE opt_events AS
SELECT 1 AS event_id, 10 AS dept_id, 100 AS amount
UNION ALL SELECT 2, 10, 80
UNION ALL SELECT 3, 10, 80
UNION ALL SELECT 4, 20, 90
UNION ALL SELECT 5, 20, 70
UNION ALL SELECT 6, 30, 60;
ANALYZE opt_events;
--
ARRAY<STRUCT<x INT64>>[]
==

[mode=explain]
# M-window: QUALIFY lowers to a Selection above the kWindow node (no
# TopN conversion yet; rank-to-TopN lowering is a follow-up).
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=Selection: ($win0 <= 2)]
[name=row_number_qualify_filters_partition_topn]
SELECT event_id, dept_id, amount
FROM opt_events
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY dept_id ORDER BY amount DESC, event_id) <= 2
ORDER BY dept_id, amount DESC, event_id
--
ARRAY<STRUCT<event_id INT64, dept_id INT64, amount INT64>>[
  {1, 10, 100}, {2, 10, 80}, {4, 20, 90}, {5, 20, 70}, {6, 30, 60}
]
==

[mode=explain]
# M-window: both calls share one WindowExecutor (one kWindow node per
# partition signature).
[plan_contains=WindowExecutor(outputs=2)]
[plan_contains=$win0 AS rn, $win1 AS running]
[name=compatible_windows_share_single_sort]
SELECT event_id,
       ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY event_id) AS rn,
       SUM(amount) OVER (PARTITION BY dept_id ORDER BY event_id
                         ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, rn INT64, running INT64>>[
  {1, 1, 100}, {2, 2, 180}, {3, 3, 260}, {4, 1, 90}, {5, 2, 160}, {6, 1, 60}
]
==

[mode=explain]
# M-window: per-call ordering lives inside the shared executor (sort
# groups are an executor-internal concern now).
[plan_contains=WindowExecutor(outputs=2)]
[plan_contains=$win0 AS high_rn, $win1 AS low_rn]
[name=incompatible_window_orders_share_executor]
SELECT event_id,
       ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY amount DESC, event_id) AS high_rn,
       ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY amount ASC, event_id) AS low_rn
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, high_rn INT64, low_rn INT64>>[
  {1, 1, 3}, {2, 2, 1}, {3, 3, 2}, {4, 1, 2}, {5, 2, 1}, {6, 1, 1}
]
==

[mode=explain]
# M-window: framing evaluates inside the shared executor through the
# canonical evaluator (frame kernels are no longer plan-visible).
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=$win0 AS running]
[name=unbounded_preceding_sum_evaluates_in_executor]
SELECT event_id,
       SUM(amount) OVER (PARTITION BY dept_id ORDER BY event_id
                         ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS running
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, running INT64>>[
  {1, 100}, {2, 180}, {3, 260}, {4, 90}, {5, 160}, {6, 60}
]
==

[mode=explain]
# M-window: see above.
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=$win0 AS moving]
[name=bounded_rows_frame_evaluates_in_executor]
SELECT event_id,
       SUM(amount) OVER (PARTITION BY dept_id ORDER BY event_id
                         ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS moving
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, moving INT64>>[
  {1, 100}, {2, 180}, {3, 160}, {4, 90}, {5, 160}, {6, 60}
]
==

[mode=explain]
# M-window: peer detection lives inside the shared executor.
[plan_contains=WindowExecutor(outputs=2)]
[plan_contains=$win0 AS r, $win1 AS dr]
[name=rank_and_dense_rank_share_executor]
SELECT event_id,
       RANK() OVER (PARTITION BY dept_id ORDER BY amount DESC) AS r,
       DENSE_RANK() OVER (PARTITION BY dept_id ORDER BY amount DESC) AS dr
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, r INT64, dr INT64>>[
  {1, 1, 1}, {2, 2, 2}, {3, 2, 2}, {4, 1, 1}, {5, 2, 2}, {6, 1, 1}
]
==

[mode=explain]
# M-window: the partition filter plans below the WindowExecutor node.
[plan_contains=Selection: (opt_events.dept_id = 10)]
[plan_contains=WindowExecutor(outputs=1)]
[name=partition_key_filter_pushes_below_window]
SELECT event_id,
       ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY event_id) AS rn
FROM opt_events WHERE dept_id = 10 ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, rn INT64>>[{1, 1}, {2, 2}, {3, 3}]
==

[mode=explain]
# M-window: the window-result filter plans above the WindowExecutor node.
[plan_contains=Selection: ($win0 = 1)]
[plan_contains=WindowExecutor(outputs=1)]
[name=window_result_filter_stays_above_window]
SELECT event_id, dept_id
FROM opt_events
QUALIFY ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY event_id) = 1
ORDER BY dept_id
--
ARRAY<STRUCT<event_id INT64, dept_id INT64>>[{1, 10}, {4, 20}, {6, 30}]
==

[mode=explain]
# M-window: offsets evaluate inside the shared executor.
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=$win0 AS previous]
[name=lag_evaluates_in_executor]
SELECT event_id,
       LAG(amount) OVER (PARTITION BY dept_id ORDER BY event_id) AS previous
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, previous INT64>>[
  {1, NULL}, {2, 100}, {3, 80}, {4, NULL}, {5, 90}, {6, NULL}
]
==

[mode=explain]
# M-window: see above.
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=$win0 AS next_amount]
[name=lead_evaluates_in_executor]
SELECT event_id,
       LEAD(amount) OVER (PARTITION BY dept_id ORDER BY event_id) AS next_amount
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, next_amount INT64>>[
  {1, 80}, {2, 80}, {3, NULL}, {4, 70}, {5, NULL}, {6, NULL}
]
==

[mode=explain]
# M-window: index-order propagation into window planning is a follow-up;
# the window evaluates with an explicit sort for now.
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=ParallelSort]
[name=indexed_input_window_evaluates_with_sort]
SELECT event_id,
       ROW_NUMBER() OVER (PARTITION BY dept_id ORDER BY amount DESC) AS rn
FROM opt_events ORDER BY dept_id, amount DESC, event_id
--
ARRAY<STRUCT<event_id INT64, rn INT64>>[
  {1, 1}, {2, 2}, {3, 3}, {4, 1}, {5, 2}, {6, 1}
]
==

[mode=explain]
# M-window: TopN plans above the window node; no Sort remains.
[plan_contains=TopN (limit=3, offset=0)]
[plan_contains=WindowExecutor(outputs=1)]
[plan_not_contains=Sort]
[name=final_order_limit_over_window]
SELECT event_id,
       ROW_NUMBER() OVER (ORDER BY amount DESC, event_id) AS rn
FROM opt_events ORDER BY amount DESC, event_id LIMIT 3
--
ARRAY<STRUCT<event_id INT64, rn INT64>>[{1, 1}, {4, 2}, {2, 3}]
==

[mode=explain]
[plan_contains=WindowAggregate fused=SUM,COUNT]
[name=same_frame_window_aggregates_are_fused]
SELECT event_id,
       SUM(amount) OVER (PARTITION BY dept_id) AS total,
       COUNT(*) OVER (PARTITION BY dept_id) AS n
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, total INT64, n INT64>>[
  {1, 260, 3}, {2, 260, 3}, {3, 260, 3},
  {4, 160, 2}, {5, 160, 2}, {6, 60, 1}
]
==

[mode=explain]
# M-window: singleton-partition elimination is a follow-up (needs a
# single-row-partition proof); the call evaluates normally for now.
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=$win0 AS rn]
[name=singleton_partition_row_number_evaluates]
SELECT event_id,
       ROW_NUMBER() OVER (PARTITION BY event_id ORDER BY amount) AS rn
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, rn INT64>>[
  {1, 1}, {2, 1}, {3, 1}, {4, 1}, {5, 1}, {6, 1}
]
==

[mode=explain]
# M-window: unique-key constant folding is a follow-up; the call
# evaluates normally for now.
[plan_contains=WindowExecutor(outputs=1)]
[plan_contains=$win0 AS rn]
[name=row_number_over_unique_partition_evaluates]
SELECT event_id,
       ROW_NUMBER() OVER (PARTITION BY event_id) AS rn
FROM opt_events ORDER BY event_id
--
ARRAY<STRUCT<event_id INT64, rn INT64>>[
  {1, 1}, {2, 1}, {3, 1}, {4, 1}, {5, 1}, {6, 1}
]
==
